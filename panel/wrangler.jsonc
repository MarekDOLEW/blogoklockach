{
  // Panel tylkoklocki.pl — OSOBNY worker, niezależny od serwisu (../wrangler.jsonc).
  // W Cloudflare: Workers & Pages → Create → Import repository (to samo repo),
  //   nazwa: tylkoklocki-panel
  //   Build command:  node panel/build.mjs
  //   Deploy command: npx wrangler deploy --config panel/wrangler.jsonc
  // Instrukcja krok po kroku: panel/README.md.
  "name": "tylkoklocki-panel",
  "compatibility_date": "2026-08-11",
  "main": "worker.js",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    // Każde żądanie, także o pliki statyczne, idzie najpierw przez sprawdzenie
    // logowania w workerze — bez tego strony panelu dałoby się pobrać z pominięciem Access.
    "run_worker_first": true
  },
  // Bez adresów *.workers.dev i podglądów wersji: jedyną drogą do panelu
  // ma być panel.tylkoklocki.pl za Cloudflare Access.
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    { "pattern": "panel.tylkoklocki.pl", "custom_domain": true }
  ],
  // Ten sam kubełek co serwis; panel pisze wyłącznie pod prefiksem _panel/wplywy/.
  "r2_buckets": [
    { "binding": "OBRAZY", "bucket_name": "tylkoklocki-obrazy" }
  ],
  "vars": {
    // Zespół Zero Trust i AUD aplikacji Access „Panel tylkoklocki” (01.11.2026; odczytane
    // z przekierowania na logowanie — to nie są sekrety). Ustawiamy je TUTAJ, nie w panelu
    // Cloudflare: deploy z repo nadpisuje zmienne. Puste = panel zamknięty dla wszystkich.
    "ACCESS_TEAM": "shiny-hill-469d",
    "ACCESS_AUD": "bbf4627fd8617223f279da3befede0f0fe4007c4d05a274b02939062c6b64447",
    // Druga zapora poza polityką Access (adresy po przecinku).
    "DOZWOLENI": "marek.dolewski@gmail.com,piotrmaculewicz@interia.pl"
  }
}
