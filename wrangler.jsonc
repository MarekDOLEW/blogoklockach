{
  "name": "blogoklockach",
  "compatibility_date": "2026-08-11",
  "main": "src/worker.js",
  "analytics_engine_datasets": [
    { "binding": "KLIKI", "dataset": "idz_kliki" }
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  }
}
