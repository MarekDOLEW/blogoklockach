---
import Base from '../layouts/Base.astro';
import dane from '../data/wycofania.json';
import redirects from '../data/redirects.json';

const fmtEl = (n) => n.toLocaleString('pl-PL');
const kolejnosc = dane._meta.serie_kolejnosc;
const wpisy = dane.wycofania;
const serie = kolejnosc.filter((s) => wpisy.some((w) => w.seria === s));
const wSerii = (s) => wpisy.filter((w) => w.seria === s);
const potwierdzone = wpisy.filter((w) => w.status === 'potwierdzone').length;
const razem = wpisy.length;
const grudniowe = wpisy.filter((w) => w.kiedy === 'grudzień 2026').length;
const juzWycofane = wpisy.filter((w) => w.kiedy === 'wycofany').length;
const slug = (s) => s.toLowerCase().replace(/\s+/g, '-');

// data aktualizacji w formacie polskim (z _meta, jedno źródło prawdy)
const MIESIACE = ['stycznia','lutego','marca','kwietnia','maja','czerwca','lipca','sierpnia','września','października','listopada','grudnia'];
const [rA, mA, dA] = dane._meta.aktualizacja.split('-').map(Number);
const aktualizacjaPL = `${dA} ${MIESIACE[mA - 1]} ${rA}`;

// FAQ — jedno źródło dla sekcji HTML i danych strukturalnych FAQPage
const faq = [
  {
    q: 'Kiedy LEGO wycofuje zestawy z produkcji?',
    a: `LEGO kończy sprzedaż zestawów w dwóch głównych falach: w połowie roku (przełom lipca i sierpnia) oraz na koniec grudnia. Największa jest fala grudniowa — w 2026 roku obejmuje ${grudniowe} zestawów z naszej listy. Daty potrafią się jednak przesuwać: LEGO czasem przedłuża życie popularnych setów albo wycofuje je przed terminem, gdy zapasy się wyczerpią.`,
  },
  {
    q: 'Czy wycofane zestawy LEGO drożeją?',
    a: 'Bardzo często tak, choć nie wszystkie w równym stopniu. Historycznie najmocniej zyskują zestawy licencyjne (Star Wars UCS, Ideas, ekskluzywy 18+), sety z unikalnymi minifigurkami oraz duże modele ekspozycyjne. Zwykłe zestawy City czy Friends drożeją wolniej albo wcale — kupuje się je przed EOL głównie po to, by nie przepłacać, a nie w celach inwestycyjnych.',
  },
  {
    q: 'Kiedy najlepiej kupić wycofywany zestaw LEGO?',
    a: 'Najkorzystniejszy moment to zwykle ostatnie tygodnie przed zniknięciem zestawu ze sklepów — sklepy wyprzedają wtedy zapasy i pojawiają się najniższe ceny w historii. Czekanie do samego końca bywa jednak ryzykowne: popularne sety potrafią wyprzedać się na długo przed oficjalną datą wycofania.',
  },
  {
    q: 'Co oznacza status „potwierdzone" i „przewidywane" na tej liście?',
    a: `„Potwierdzone" oznacza oficjalny sygnał od LEGO — zestaw trafił do działu „Ostatnie sztuki" na lego.com albo został już wyprzedany. „Przewidywane" to zgodne prognozy społeczności (m.in. Brick Fanatics i Brickset), które zwykle się sprawdzają, ale LEGO może je jeszcze zmienić. Obecnie lista zawiera ${potwierdzone} pozycji potwierdzonych i ${razem - potwierdzone} przewidywanych.`,
  },
  {
    q: 'Które zestawy LEGO znikną w grudniu 2026?',
    a: `Fala grudniowa 2026 to ${grudniowe} zestawów — m.in. kolekcjonerski Sokół Millennium 75192 po dziewięciu latach sprzedaży, Muzeum Historii Naturalnej 10326, rezydencja X-Men 76294 i duża część aktualnej oferty City, Friends oraz Ninjago. Pełny podział znajdziesz na tej stronie po przefiltrowaniu wybranej serii.`,
  },
  {
    q: 'Co to jest EOL w LEGO?',
    a: 'EOL to skrót od „end of life" — moment, w którym LEGO na stałe kończy produkcję i sprzedaż zestawu. Po EOL set nie wraca już do regularnej oferty (wznowienia zdarzają się wyjątkowo rzadko), a jedynym źródłem stają się resztki magazynowe sklepów i rynek wtórny.',
  },
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faq.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};

const stronaSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  name: 'Wycofywane zestawy LEGO 2026 — pełna lista końcówek serii',
  inLanguage: 'pl-PL',
  dateModified: dane._meta.aktualizacja,
  description: `Lista ${razem} zestawów LEGO wycofywanych w 2026 roku, z podziałem na serie i statusem potwierdzenia.`,
};
---
<Base
  title="Wycofywane zestawy LEGO 2026 — pełna lista końcówek serii (EOL)"
  description={`Które zestawy LEGO znikają w 2026? Pełna lista ${razem} wycofań: Star Wars, Icons, Ideas, Technic, Harry Potter i inne. ${potwierdzone} pozycji potwierdzonych przez LEGO. Aktualizacja: ${aktualizacjaPL}.`}
>
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(stronaSchema)} />
  <article>
    <h1 style="margin-top:28px">Wycofywane zestawy LEGO 2026 — pełna lista końcówek serii</h1>
    <p class="eol-aktualizacja">Ostatnia aktualizacja: <time datetime={dane._meta.aktualizacja}>{aktualizacjaPL}</time> · {razem} zestawów · {potwierdzone} potwierdzonych przez LEGO · {juzWycofane} już wycofanych</p>
    <p class="prose">Gdy LEGO wycofuje zestaw z produkcji, jego cena najpierw bywa najniższa w historii — a po zniknięciu z półek zaczyna rosnąć na rynku wtórnym. Zebraliśmy w jednym miejscu <strong>wszystkie {razem} zestawów, które znikają ze sprzedaży w 2026 roku</strong>, w 11 seriach: od Star Wars i Icons po City i Friends. Użyj filtra poniżej, by zawęzić listę do swojej serii, albo wpisz numer lub nazwę zestawu w wyszukiwarkę. Status „potwierdzone" oznacza oficjalną informację LEGO (dział „Ostatnie sztuki"); „przewidywane" — zgodne prognozy społeczności. Wracaj tu regularnie — listę aktualizujemy na bieżąco.</p>
    <p class="disclosure">Przyciski „Sprawdź cenę" to linki afiliacyjne — kupując przez nie, wspierasz serwis, nie płacąc więcej.</p>

    <div class="eol-filtr karta" role="search" aria-label="Filtrowanie listy wycofań">
      <div class="eol-filtr-pole">
        <label for="eol-seria">Seria</label>
        <select id="eol-seria">
          <option value="">Wszystkie serie</option>
          {serie.map((s) => (
            <option value={s}>{s} ({wSerii(s).length})</option>
          ))}
        </select>
      </div>
      <div class="eol-filtr-pole eol-filtr-szukaj">
        <label for="eol-szukaj">Szukaj zestawu</label>
        <div class="eol-autocomplete">
          <input
            id="eol-szukaj"
            type="search"
            placeholder="numer lub nazwa, np. 10334 albo Sokół…"
            autocomplete="off"
            role="combobox"
            aria-expanded="false"
            aria-controls="eol-podpowiedzi"
            aria-autocomplete="list"
          />
          <ul id="eol-podpowiedzi" role="listbox" hidden></ul>
        </div>
      </div>
      <div class="eol-filtr-pole eol-filtr-reset">
        <button type="button" id="eol-wyczysc" hidden>Wyczyść ✕</button>
        <span id="eol-licznik" aria-live="polite"></span>
      </div>
    </div>

    {serie.map((seria) => (
      <section class="sekcja eol-sekcja" id={`seria-${slug(seria)}`} data-seria={seria} style="margin: 30px 0;">
        <div class="sekcja-head">
          <span class="studs studs--granat" aria-hidden="true"><i></i><i></i><i></i><i></i></span>
          <h2>{seria}</h2>
        </div>
        <div class="eol-lista">
          {wSerii(seria).map((w) => (
            <div class="karta eol-wiersz" id={`set-${w.numer}`} data-numer={w.numer} data-nazwa={w.nazwa} data-seria={w.seria}>
              <div class="eol-mini">
                {w.zdjecie ? (
                  <img src={w.zdjecie} alt={`LEGO ${w.numer} ${w.nazwa}`} loading="lazy" width="120" height="120" />
                ) : (
                  <div class="eol-mini-placeholder" aria-hidden="true">
                    <span class="studs"><i></i><i></i><i></i><i></i></span>
                  </div>
                )}
              </div>
              <div class="eol-info">
                <span class="nr">LEGO {w.numer}</span>
                <h3>{w.nazwa}</h3>
                <p class="eol-uwagi">{w.uwagi}</p>
                <div class="deal-meta">
                  <span><strong>{fmtEl(w.elementy)}</strong> elementów</span>
                </div>
              </div>
              <div class="eol-akcja">
                <span class={w.status === 'potwierdzone' ? 'badge-rabat eol-badge' : 'badge-seria'}>
                  {w.kiedy === 'wycofany' ? 'wycofany' : `znika: ${w.kiedy}`}
                </span>
                <span class="eol-status">{w.status === 'potwierdzone' ? '✓ potwierdzone przez LEGO' : 'przewidywane'}</span>
                {redirects.planetaklockow?.[w.numer] ? (
                  <a class="cta" href={`/idz/planetaklockow/${w.numer}`} rel="sponsored nofollow">Sprawdź cenę →</a>
                ) : redirects.mediaexpert?.[w.numer] ? (
                  <a class="cta" href={`/idz/mediaexpert/${w.numer}`} rel="sponsored nofollow">Sprawdź cenę →</a>
                ) : null}
              </div>
            </div>
          ))}
        </div>
        <p class="eol-pusto" hidden>Brak wyników w tej serii dla obecnego filtra.</p>
      </section>
    ))}

    <section class="sekcja karta" style="padding:18px 22px;">
      <h2>Jak czytać tę listę?</h2>
      <p class="prose" style="margin:0">Dla <strong>rodzica</strong>: jeśli zestaw z listy jest na liście życzeń dziecka — kup przed zniknięciem, po EOL ceny rosną zamiast spadać. Dla <strong>kolekcjonera</strong>: fala przecen tuż przed wycofaniem to często ostatni moment na najniższą cenę w historii; sety licencyjne (Ideas, ekskluzywy) historycznie zyskują najwięcej. Daty podajemy za LEGO — firma potrafi je zmieniać, więc wracaj tu regularnie.</p>
    </section>

    <section class="sekcja eol-faq" id="faq" style="margin: 34px 0;">
      <div class="sekcja-head">
        <span class="studs studs--granat" aria-hidden="true"><i></i><i></i><i></i><i></i></span>
        <h2>Wycofania LEGO — najczęstsze pytania</h2>
      </div>
      {faq.map((f) => (
        <div class="karta eol-faq-wpis">
          <h3>{f.q}</h3>
          <p class="prose">{f.a}</p>
        </div>
      ))}
    </section>
  </article>
</Base>

<style is:global>
  .eol-filtr {
    display: flex;
    flex-wrap: wrap;
    gap: 14px 18px;
    align-items: flex-end;
    padding: 14px 18px;
    margin: 18px 0 6px;
    position: sticky;
    top: 8px;
    z-index: 20;
  }
  .eol-filtr-pole { display: flex; flex-direction: column; gap: 4px; }
  .eol-filtr-pole label { font-size: 0.8rem; font-weight: 600; opacity: 0.75; }
  .eol-filtr select,
  .eol-filtr input[type="search"] {
    font: inherit;
    padding: 8px 12px;
    border: 1.5px solid rgba(0,0,0,0.18);
    border-radius: 8px;
    background: #fff;
    min-width: 190px;
  }
  .eol-filtr-szukaj { flex: 1 1 260px; }
  .eol-filtr-szukaj input { width: 100%; }
  .eol-filtr-reset { flex-direction: row; align-items: center; gap: 10px; }
  #eol-wyczysc {
    font: inherit;
    font-size: 0.85rem;
    padding: 7px 12px;
    border: 1.5px solid rgba(0,0,0,0.18);
    border-radius: 8px;
    background: #fff;
    cursor: pointer;
  }
  #eol-wyczysc:hover { background: #f3f3f3; }
  #eol-licznik { font-size: 0.85rem; opacity: 0.7; white-space: nowrap; }

  .eol-autocomplete { position: relative; }
  #eol-podpowiedzi {
    position: absolute;
    top: calc(100% + 4px);
    left: 0;
    right: 0;
    margin: 0;
    padding: 4px;
    list-style: none;
    background: #fff;
    border: 1.5px solid rgba(0,0,0,0.15);
    border-radius: 10px;
    box-shadow: 0 8px 24px rgba(0,0,0,0.12);
    max-height: 320px;
    overflow-y: auto;
    z-index: 30;
  }
  #eol-podpowiedzi li {
    padding: 8px 10px;
    border-radius: 7px;
    cursor: pointer;
    display: flex;
    gap: 8px;
    align-items: baseline;
    font-size: 0.92rem;
  }
  #eol-podpowiedzi li .p-nr { font-weight: 700; font-variant-numeric: tabular-nums; }
  #eol-podpowiedzi li .p-seria { margin-left: auto; font-size: 0.78rem; opacity: 0.6; }
  #eol-podpowiedzi li:hover,
  #eol-podpowiedzi li[aria-selected="true"] { background: #eef2ff; }
  #eol-podpowiedzi li mark { background: #ffe9a8; padding: 0 1px; border-radius: 2px; }

  .eol-wiersz.eol-hit {
    outline: 3px solid #f5c518;
    outline-offset: 2px;
    transition: outline-color 1.2s ease;
  }
  .eol-pusto { font-size: 0.9rem; opacity: 0.65; padding: 6px 2px; }

  .eol-aktualizacja {
    font-size: 0.85rem;
    opacity: 0.7;
    margin: 4px 0 14px;
  }
  .eol-faq-wpis { padding: 14px 18px; margin: 12px 0; }
  .eol-faq-wpis h3 { margin: 0 0 6px; font-size: 1.05rem; }
  .eol-faq-wpis p { margin: 0; }
</style>

<script>
  // ── Filtr serii + wyszukiwarka z autouzupełnianiem ──────────────────────
  // Pełna lista jest wyrenderowana w HTML (SEO); JS tylko ukrywa elementy.
  const MIN_ZNAKOW = 3;      // od ilu znaków pokazujemy podpowiedzi
  const MAX_PODPOWIEDZI = 8;

  const $seria   = document.getElementById('eol-seria');
  const $szukaj  = document.getElementById('eol-szukaj');
  const $lista   = document.getElementById('eol-podpowiedzi');
  const $wyczysc = document.getElementById('eol-wyczysc');
  const $licznik = document.getElementById('eol-licznik');
  const sekcje   = [...document.querySelectorAll('.eol-sekcja')];
  const wiersze  = [...document.querySelectorAll('.eol-wiersz')];
  const RAZEM    = wiersze.length;

  // znormalizowany indeks (bez polskich znaków, lowercase)
  const norm = (s) => s.toLowerCase().normalize('NFD').replace(/[\u0300-\u036f]/g, '').replace(/ł/g, 'l');
  const indeks = wiersze.map((el) => ({
    el,
    numer: el.dataset.numer,
    nazwa: el.dataset.nazwa,
    seria: el.dataset.seria,
    n: norm(el.dataset.nazwa),
  }));

  let aktywna = -1; // podświetlona podpowiedź (klawiatura)

  function zastosujFiltr() {
    const s = $seria.value;
    const q = norm($szukaj.value.trim());
    let widoczne = 0;

    for (const w of indeks) {
      const pasujeSeria = !s || w.seria === s;
      const pasujeFraza = !q || w.numer.startsWith(q) || w.n.includes(q);
      const pokaz = pasujeSeria && pasujeFraza;
      w.el.hidden = !pokaz;
      if (pokaz) widoczne++;
    }
    for (const sek of sekcje) {
      const maWidoczne = [...sek.querySelectorAll('.eol-wiersz')].some((r) => !r.hidden);
      const filtrAktywny = s || q;
      sek.hidden = filtrAktywny && !maWidoczne && sek.dataset.seria !== s ? true : false;
      if (s && sek.dataset.seria !== s) sek.hidden = true;
      const pusto = sek.querySelector('.eol-pusto');
      if (pusto) pusto.hidden = !( !sek.hidden && !maWidoczne );
    }

    const filtrAktywny = s || $szukaj.value.trim();
    $wyczysc.hidden = !filtrAktywny;
    $licznik.textContent = filtrAktywny ? `Pokazano ${widoczne} z ${RAZEM} zestawów` : '';

    // stan w URL — łatwo podlinkować np. /wycofania/?seria=Icons
    const url = new URL(location.href);
    if (s) url.searchParams.set('seria', s); else url.searchParams.delete('seria');
    if ($szukaj.value.trim()) url.searchParams.set('q', $szukaj.value.trim()); else url.searchParams.delete('q');
    history.replaceState(null, '', url);
  }

  // ── podpowiedzi ──
  function pokazPodpowiedzi() {
    const surowe = $szukaj.value.trim();
    const q = norm(surowe);
    if (q.length < MIN_ZNAKOW) return schowajPodpowiedzi();

    const s = $seria.value;
    const trafienia = indeks
      .filter((w) => (!s || w.seria === s) && (w.numer.startsWith(q) || w.n.includes(q)))
      .slice(0, MAX_PODPOWIEDZI);

    if (!trafienia.length) return schowajPodpowiedzi();

    $lista.innerHTML = '';
    trafienia.forEach((w, i) => {
      const li = document.createElement('li');
      li.setAttribute('role', 'option');
      li.id = `eol-opt-${i}`;
      const idx = w.n.indexOf(q);
      let nazwaHTML = w.nazwa;
      if (!w.numer.startsWith(q) && idx >= 0) {
        // podświetl dopasowany fragment nazwy (pozycje 1:1 dzięki normalizacji bez zmiany długości)
        nazwaHTML = w.nazwa.slice(0, idx) + '<mark>' + w.nazwa.slice(idx, idx + q.length) + '</mark>' + w.nazwa.slice(idx + q.length);
      }
      li.innerHTML = `<span class="p-nr">${w.numer.startsWith(q) ? '<mark>' + w.numer.slice(0, q.length) + '</mark>' + w.numer.slice(q.length) : w.numer}</span><span>${nazwaHTML}</span><span class="p-seria">${w.seria}</span>`;
      li.addEventListener('mousedown', (e) => { e.preventDefault(); wybierz(w); });
      $lista.appendChild(li);
    });
    aktywna = -1;
    $lista.hidden = false;
    $szukaj.setAttribute('aria-expanded', 'true');
  }

  function schowajPodpowiedzi() {
    $lista.hidden = true;
    $lista.innerHTML = '';
    aktywna = -1;
    $szukaj.setAttribute('aria-expanded', 'false');
  }

  function wybierz(w) {
    schowajPodpowiedzi();
    // zawęź listę do wybranego numeru, przewiń do wiersza i podświetl
    $szukaj.value = w.numer;
    zastosujFiltr();
    w.el.scrollIntoView({ behavior: 'smooth', block: 'center' });
    w.el.classList.add('eol-hit');
    setTimeout(() => w.el.classList.remove('eol-hit'), 2500);
  }

  // ── zdarzenia ──
  $szukaj.addEventListener('input', () => { zastosujFiltr(); pokazPodpowiedzi(); });
  $seria.addEventListener('change', () => { zastosujFiltr(); schowajPodpowiedzi(); });
  $szukaj.addEventListener('blur', () => setTimeout(schowajPodpowiedzi, 120));
  $wyczysc.addEventListener('click', () => {
    $seria.value = '';
    $szukaj.value = '';
    zastosujFiltr();
    schowajPodpowiedzi();
  });

  $szukaj.addEventListener('keydown', (e) => {
    const opcje = [...$lista.querySelectorAll('li')];
    if ($lista.hidden || !opcje.length) return;
    if (e.key === 'ArrowDown' || e.key === 'ArrowUp') {
      e.preventDefault();
      aktywna = e.key === 'ArrowDown'
        ? (aktywna + 1) % opcje.length
        : (aktywna - 1 + opcje.length) % opcje.length;
      opcje.forEach((o, i) => o.setAttribute('aria-selected', i === aktywna ? 'true' : 'false'));
      opcje[aktywna].scrollIntoView({ block: 'nearest' });
      $szukaj.setAttribute('aria-activedescendant', opcje[aktywna].id);
    } else if (e.key === 'Enter' && aktywna >= 0) {
      e.preventDefault();
      const q = norm($szukaj.value.trim());
      const s = $seria.value;
      const trafienia = indeks.filter((w) => (!s || w.seria === s) && (w.numer.startsWith(q) || w.n.includes(q)));
      if (trafienia[aktywna]) wybierz(trafienia[aktywna]);
    } else if (e.key === 'Escape') {
      schowajPodpowiedzi();
    }
  });

  // ── stan startowy z URL (?seria=Icons&q=sokol) ──
  const params = new URLSearchParams(location.search);
  const pSeria = params.get('seria');
  const pQ = params.get('q');
  if (pSeria && [...$seria.options].some((o) => o.value === pSeria)) $seria.value = pSeria;
  if (pQ) $szukaj.value = pQ;
  if (pSeria || pQ) zastosujFiltr();
</script>
