---
import Base from '../../layouts/Base.astro';
import SzukajZestawuInline from '../../components/SzukajZestawuInline.astro';
import KafleSerii from '../../components/KafleSerii.astro';
import { kafleSerii } from '../../lib/serie-listing.js';

// Tylko serie aktualne (z zestawami w ofercie lego.pl). Archiwalne mają własną
// stronę /serie/archiwalne/ — przycisk przy nagłówku (decyzja Marka 15.09.2026).
const kafle = kafleSerii(false);
const archiwalnych = kafleSerii(true).length;
---
<Base title="Klocki LEGO według serii" description="Przeglądaj zestawy LEGO według serii: Technic, Icons, Star Wars, Pokémon i inne. Ceny i promocje w jednym miejscu.">
  <div class="naglowek-akcja">
    <h1>Serie LEGO</h1>
    <a class="przycisk-drugi" href="/serie/archiwalne/">Serie archiwalne ({archiwalnych}) →</a>
  </div>
  <p>Każda seria to osobny katalog z aktualnymi cenami i statusem wycofania. Na kaflach – najświeższe zestawy z danej serii.</p>

  <SzukajZestawuInline />

  <KafleSerii kafle={kafle} />
</Base>
