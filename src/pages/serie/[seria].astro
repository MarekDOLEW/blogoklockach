---
import Base from '../../layouts/Base.astro';
import FiltrSetow from '../../components/FiltrSetow.astro';
import TabelaSetow from '../../components/TabelaSetow.astro';
import sety from '../../data/sety.json';
import katalog from '../../data/katalog.json';
import ofertyFeed from '../../data/oferty_feed.json';
import { urlZdjecia, opisSetu } from '../../lib/media.js';
import { najlepszaOferta, linkAfiliacyjny, jakikolwiekLink, fmtCena } from '../../lib/oferty.js';
import { maHub } from '../../lib/huby.js';

export function getStaticPaths() {
  const zSetow = [...new Set(Object.values(sety).map((s) => s.seria))];
  const zKatalogu = Object.keys(katalog).filter((k) => k !== '_meta');
  const serie = [...new Set([...zSetow, ...zKatalogu])];
  return serie.map((seria) => ({
    params: { seria: seria.toLowerCase().normalize('NFD').replace(/[\u0300-\u036f]/g, '').replace(/\s+/g, '-') },
    props: { seria },
  }));
}

const { seria } = Astro.props;
const wSerii = Object.entries(sety).filter(([, s]) => s.seria === seria).map(([nr, s]) => ({ nr, ...s }));
const hist = (katalog[seria] ?? []).slice().sort((a, b) => b.rok - a.rok);
const rokMin = hist.length ? Math.min(...hist.map((s) => s.rok)) : null;

const feedSety = ofertyFeed?.sety ?? {};

// Wiersze do wspólnej tabeli — ten sam kształt co na /wycofania/.
const wiersze = hist.map((s) => {
  const oferta = najlepszaOferta(s.numer, { sety, feed: feedSety });
  const link = oferta
    ? linkAfiliacyjny(oferta.sklep, s.numer)
    : (jakikolwiekLink(s.numer)?.url ?? null);
  return {
    numer: s.numer,
    nazwa: s.nazwa,
    opis: opisSetu(s.numer, { sety })?.tekst ?? null,
    seria,
    rok: s.rok,
    elementy: s.elementy,
    zdjecie: urlZdjecia(s.numer, { sety, feed: feedSety }),
    hub: maHub(s.numer),
    status: s.status === 'eol' ? 'eol' : 'sprzedaz',
    oferta,
    link,
  };
});
---
<Base
  title={`LEGO ${seria} — zestawy, ceny, promocje${hist.length ? ` i pełny katalog serii od ${rokMin}` : ''}`}
  description={`Zestawy LEGO z serii ${seria}: aktualne ceny i promocje${hist.length ? ` oraz kompletny katalog wszystkich ${hist.length} zestawów serii z lat ${rokMin}–${new Date().getFullYear()}, ze statusem wycofania (EOL)` : ''}.`}
>
  <h1 style="margin-top:28px">LEGO {seria}</h1>

  {(wSerii.length > 0 || hist.length > 0) && (
    <FiltrSetow
      etykieta={`Szukaj w serii ${seria}`}
      placeholder="numer lub nazwa, np. 10334 albo Sokół…"
      rzeczownik="zestawów serii"
    />
  )}

  {wSerii.length > 0 && (
    <section data-grupa>
      <h2>Śledzone zestawy i ceny</h2>
      <div class="siatka">
        {wSerii.map((s) => (
          <a
            class="karta set-karta"
            href={`/zestaw/${s.nr}/`}
            data-wiersz
            data-licz="0"
            data-numer={s.nr}
            data-nazwa={s.nazwa}
            data-seria={s.seria}
          >
            {s.zdjecia?.glowne && <img class="miniatura" src={s.zdjecia.glowne} alt={`LEGO ${s.nr} ${s.nazwa}`} loading="lazy" width="400" height="300" />}
            <span class="nr">LEGO {s.nr} {s.ekskluzyw && <span class="badge-ex">ekskluzyw</span>}</span>
            <h3>{s.nazwa}</h3>
            <div class="cena-linia"><span class="cena">{fmtCena(Math.min(...s.oferty.map((o) => o.cena)))}</span><span class="za-klocek">{s.elementy} el.</span></div>
          </a>
        ))}
      </div>
    </section>
  )}

  {hist.length > 0 && (
    <section class="sekcja" data-grupa>
      <div class="sekcja-head">
        <span class="studs studs--granat" aria-hidden="true"><i></i><i></i><i></i><i></i></span>
        <h2>Pełny katalog serii {seria} ({rokMin}–{Math.max(...hist.map((s) => s.rok))})</h2>
      </div>
      <p>Wszystkie zestawy serii — także wycofane z produkcji (EOL). Zestawy EOL kupisz już tylko na rynku wtórnym; ich ceny często przewyższają katalogowe, co czyni serię {seria} jedną z ciekawszych inwestycyjnie.</p>
      <p class="disclosure">Ceny prowadzą przez linki afiliacyjne — kupując przez nie, wspierasz serwis, nie płacąc więcej. Ceny pobieramy z cenników sklepów; trwające promocje i kody rabatowe bywają w nich niewidoczne, więc cena w sklepie może się różnić od podanej — zwykle na Twoją korzyść.</p>
      <TabelaSetow wiersze={wiersze} />
      <p class="lista-pusta" data-pusto hidden>Żaden zestaw z tej serii nie pasuje do wyszukiwania.</p>
    </section>
  )}
</Base>
