---
import Base from '../../layouts/Base.astro';
import FiltrSetow from '../../components/FiltrSetow.astro';
import TabelaSetow from '../../components/TabelaSetow.astro';
import { seriaArchiwalna } from '../../lib/serie-listing.js';
import sety from '../../data/sety.json';
import katalog from '../../data/katalog.json';
import ofertyFeed from '../../data/oferty_feed.json';
import { urlZdjecia, opisSetu, obrazPlynny } from '../../lib/media.js';
import { najlepszaOferta, linkAfiliacyjny, fmtCena, cenaKatalogowaSetu, odmien } from '../../lib/oferty.js';
import { maHub } from '../../lib/huby.js';
import { statusListingu } from '../../lib/status.js';

export function getStaticPaths() {
  const zSetow = [...new Set(Object.values(sety).map((s) => s.seria))];
  const zKatalogu = Object.keys(katalog).filter((k) => k !== '_meta');
  const serie = [...new Set([...zSetow, ...zKatalogu])];
  return serie.map((seria) => ({
    params: { seria: seria.toLowerCase().normalize('NFD').replace(/[\u0300-\u036f]/g, '').replace(/\s+/g, '-') },
    props: { seria },
  }));
}

const { seria } = Astro.props;
const teraz = new Date();
const biezacyYm = `${teraz.getFullYear()}-${String(teraz.getMonth() + 1).padStart(2, '0')}`;
// Katalog serii plus zestawy, które są już w sety.json (w sprzedaży), a katalog
// jeszcze ich nie zna (np. Icons 40872). Do 11.10.2026 widać je było tylko
// w boksach „z aktualnymi cenami"; zapowiedzi zostają na /nowosci/.
const zKatalogu = katalog[seria] ?? [];
const numeryKatalogu = new Set(zKatalogu.map((s) => s.numer));
const spozaKatalogu = Object.entries(sety)
  .filter(([nr, s]) => s.seria === seria && !numeryKatalogu.has(nr))
  .filter(([, s]) => /^\d{4}-\d{2}$/.test(s.premiera ?? '') && s.premiera <= biezacyYm)
  .map(([nr, s]) => ({ numer: nr, nazwa: s.nazwa, rok: Number(s.premiera.slice(0, 4)), elementy: s.elementy }));
const hist = [...zKatalogu, ...spozaKatalogu].sort((a, b) => b.rok - a.rok);
const rokMin = hist.length ? Math.min(...hist.map((s) => s.rok)) : null;

const feedSety = ofertyFeed?.sety ?? {};

// Wiersze do wspólnej tabeli – ten sam kształt co na /wycofania/.
// Status liczy src/lib/status.js z listy wycofań i katalogu, więc zestaw, który
// LEGO już wycofało, a sklepy jeszcze mają (np. 76264), dostaje „w sprzedaży"
// z dopiskiem EOL, a zestaw z listy wycofań – „potwierdzone przez LEGO" albo
// „prognoza rynku" zamiast gołego „w sprzedaży".
const archiwalna = seriaArchiwalna(seria);
const wiersze = hist.map((s) => {
  const sklepowa = najlepszaOferta(s.numer, { sety, feed: feedSety });
  const cenaKat = cenaKatalogowaSetu(s.numer, { sety });
  const status = statusListingu(s.numer, { maOferte: Boolean(sklepowa && sklepowa.sklep !== 'lego') });
  // dopóki LEGO sprzedaje zestaw, brak ofert sklepów nie oznacza braku ceny –
  // pokazujemy cenę katalogową z linkiem do LEGO.com. Po EOL w LEGO bez oferty
  // nie ma linku „na ślepo" – wiersz mówi „brak w sprzedaży".
  let oferta = sklepowa;
  if (!oferta && !status.eolLego && cenaKat) oferta = { sklep: 'lego', cena: cenaKat, data: null };
  const link = oferta ? linkAfiliacyjny(oferta.sklep, s.numer) : null;
  return {
    numer: s.numer,
    nazwa: s.nazwa,
    opis: opisSetu(s.numer, { sety })?.tekst ?? null,
    seria,
    rok: s.rok,
    elementy: s.elementy,
    zdjecie: urlZdjecia(s.numer, { sety, feed: feedSety }),
    hub: maHub(s.numer),
    status: status.badge,
    eolLego: status.eolLego,
    eolPewny: status.eolPewny,
    kiedy: status.kiedy,
    oferta,
    link,
    cenaKatalogowa: cenaKat,
  };
});
const lata = [...wiersze.reduce((m, w) => m.set(w.rok, (m.get(w.rok) ?? 0) + 1), new Map())]
  .filter(([rok]) => rok)
  .sort((a, b) => b[0] - a[0])
  .map(([rok, ile]) => ({ rok, ile }));

// Nasze propozycje: 9 zestawów (3 slajdy po 3) losowanych spośród tych, które
// są w bieżącej ofercie LEGO, da się je kupić i mają zdjęcie oraz kartę. Ziarno = seria + dzień, więc
// wybór zmienia się codziennie z kolejnym buildem, a w ciągu dnia jest stały
// (bez przeskakiwania po odświeżeniu i bez skryptu po stronie czytelnika).
const PROPOZYCJE = 9;
const ziarno = [...`${seria}|${teraz.toISOString().slice(0, 10)}`].reduce((h, z) => Math.imul(h ^ z.charCodeAt(0), 16777619), 2166136261) >>> 0;
const losuj = ((a) => () => {
  a = (a + 0x6d2b79f5) >>> 0;
  let t = Math.imul(a ^ (a >>> 15), 1 | a);
  t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
  return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
})(ziarno);
// Tylko bieżąca oferta LEGO: zestaw sprzed lat sprzedawany na Allegro za
// wielokrotność ceny katalogowej (np. 10173 Holiday Train) to nie propozycja.
const pula = wiersze.filter((w) => w.oferta && w.zdjecie && w.hub && w.status !== 'eol' && !w.eolLego);
for (let i = pula.length - 1; i > 0; i--) {
  const j = Math.floor(losuj() * (i + 1));
  [pula[i], pula[j]] = [pula[j], pula[i]];
}
const ilePropozycji = Math.min(pula.length, PROPOZYCJE);
const propozycje = pula.slice(0, ilePropozycji - (ilePropozycji % 3));
const ekskluzyw = (nr) => Boolean(sety[nr]?.ekskluzyw);
---
<Base
  title={`LEGO ${seria} – ceny i katalog serii`}
  description={`Ceny zestawów LEGO ${seria} w polskich sklepach i rabat od ceny katalogowej.${hist.length ? ` W katalogu ${hist.length} ${odmien(hist.length, 'zestaw', 'zestawy', 'zestawów')} ${rokMin === new Date().getFullYear() ? `z ${rokMin} roku` : `z lat ${rokMin}–${new Date().getFullYear()}`}, ze statusem wycofania.` : ''}`}
  jsonld={{
    '@context': 'https://schema.org',
    '@type': 'ItemList',
    name: `Zestawy LEGO ${seria}`,
    numberOfItems: wiersze.length,
    itemListElement: wiersze.slice(0, 50).map((w, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      name: `LEGO ${w.numer} ${w.nazwa}`,
      ...(w.hub ? { url: new URL(`/zestaw/${w.numer}/`, Astro.site).href } : {}),
    })),
  }}
>
  <h1 style="margin-top:28px">LEGO {seria}</h1>
  {archiwalna && (
    <p class="karta" style="padding: 12px 16px; margin: 12px 0 18px;"><strong>Seria archiwalna</strong> – LEGO nie ma już tej linii w ofercie. Zestawy zostają w katalogu na zawsze; ceny, które widzisz, pochodzą z rynku wtórnego. <a href="/serie/archiwalne/">Wszystkie serie archiwalne →</a></p>
  )}

  {propozycje.length > 0 && (
    <section class="propozycje" aria-roledescription="karuzela" aria-label={`Nasze propozycje z serii ${seria}`}>
      <div class="propozycje__head">
        <h2>Nasze propozycje</h2>
        {propozycje.length > 3 && (
          <div class="propozycje__nav">
            <button type="button" class="propozycje__btn" data-kier="-1" aria-label="Poprzednie propozycje">‹</button>
            <span class="propozycje__licznik" aria-live="polite">1/{Math.ceil(propozycje.length / 3)}</span>
            <button type="button" class="propozycje__btn" data-kier="1" aria-label="Następne propozycje">›</button>
          </div>
        )}
      </div>
      <div class="propozycje__tor">
        {propozycje.map((w, i) => (
          <a class="karta set-karta" href={`/zestaw/${w.numer}/`} target="_blank" rel="noopener">
            <img class="miniatura" {...obrazPlynny(w.zdjecie, [260, 440, 880], '(max-width: 600px) 78vw, 330px')} alt={`LEGO ${w.numer} ${w.nazwa}`} loading={i < 3 ? 'eager' : 'lazy'} fetchpriority={i === 0 ? 'high' : undefined} width="400" height="300" />
            <span class="nr">LEGO {w.numer} {ekskluzyw(w.numer) && <span class="badge-ex">ekskluzyw</span>}</span>
            <h3>{w.nazwa}</h3>
            <div class="cena-linia"><span class="cena">{fmtCena(w.oferta.cena)}</span><span class="za-klocek">{w.elementy ? `${w.elementy} el.` : ''}</span></div>
          </a>
        ))}
      </div>
    </section>
  )}

  {hist.length > 0 && (
    <section class="sekcja" data-grupa>
      <div class="sekcja-head">
        <span class="studs studs--granat" aria-hidden="true"><i></i><i></i><i></i><i></i></span>
        <h2>Pełny katalog serii {seria} ({rokMin}–{Math.max(...hist.map((s) => s.rok))})</h2>
      </div>
      <p>Wszystkie zestawy serii – także te, których nie ma już w sklepie LEGO (znacznik <span class="tag-eol">brak w lego.pl</span>; „EOL" tylko tam, gdzie wycofanie potwierdza nasza lista). Część wycofanych zestawów wciąż kupisz w innych sklepach – wtedy pokazujemy aktualną cenę; resztę już tylko na rynku wtórnym, gdzie ceny często przewyższają katalogowe.</p>
      <FiltrSetow
        etykieta="Szukaj"
        placeholder="numer lub nazwa, np. 10334 albo Sokół…"
        rzeczownik="zestawów serii"
        lata={lata}
        sortowanie
        tylkoDostepne
      />
      <p class="disclosure">Linki przy cenach to linki afiliacyjne: kupując przez nie, wspierasz serwis i nie płacisz więcej. Kwota przy zestawie to ostatnia cena, jaką zobaczyliśmy w cenniku sklepu – kody rabatowe i zmiany w ciągu dnia mogą ją przesunąć, więc wiążąca jest cena w koszyku.</p>
      <TabelaSetow wiersze={wiersze} />
      <p class="lista-pusta" data-pusto hidden>Żaden zestaw z tej serii nie pasuje do wyszukiwania.</p>
    </section>
  )}
</Base>

<script>
  // Karuzela propozycji: przewija o szerokość widocznej części, czyli trójkami
  // na desktopie i po jednym na telefonie; licznik liczy strony, nie zestawy.
  const $p = document.querySelector('.propozycje');
  const $tor = $p?.querySelector('.propozycje__tor');
  const $licznik = $p?.querySelector('.propozycje__licznik');
  if ($tor && $licznik) {
    // krok strony = widoczna szerokość + odstęp między boksami
    const krok = () => $tor.clientWidth + (parseFloat(getComputedStyle($tor).columnGap) || 0);
    const strony = () => Math.max(1, Math.round(($tor.scrollWidth + (krok() - $tor.clientWidth)) / krok()));
    const strona = () => Math.min(strony(), Math.round($tor.scrollLeft / krok()) + 1);
    const odswiez = () => ($licznik.textContent = `${strona()}/${strony()}`);
    $p.querySelectorAll('.propozycje__btn').forEach((b) =>
      b.addEventListener('click', () => {
        const kier = Number(b.dataset.kier);
        const nast = strona() - 1 + kier;
        const cel = nast < 0 ? strony() - 1 : nast >= strony() ? 0 : nast;
        $tor.scrollTo({ left: cel * krok(), behavior: 'smooth' });
      }),
    );
    $tor.addEventListener('scroll', () => requestAnimationFrame(odswiez), { passive: true });
    addEventListener('resize', odswiez);
    odswiez();
  }
</script>
