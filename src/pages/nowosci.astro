---
import Base from '../layouts/Base.astro';
import FiltrSetow from '../components/FiltrSetow.astro';
import sety from '../data/sety.json';
import { urlZdjecia } from '../lib/media.js';
import { miesiac, PROG_SETOW } from '../lib/miesiace.js';
const fmt = (c) => c.toLocaleString('pl-PL', { minimumFractionDigits: 2 }) + ' zł';
const ym = (d) => `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, '0')}`;
const teraz = new Date();
const odKiedy = ym(new Date(teraz.getFullYear(), teraz.getMonth() - 2, 1));
const biezacy = ym(teraz);
const nowe = Object.entries(sety)
  .filter(([, s]) => s.premiera >= odKiedy)
  .map(([nr, s]) => ({ nr, ...s, foto: urlZdjecia(nr, { sety }) }))
  .sort((a, b) => (a.premiera > b.premiera ? -1 : a.premiera < b.premiera ? 1 : 0));
const serie = [...new Set(nowe.map((s) => s.seria))].sort((a, b) => a.localeCompare(b, 'pl'));

// Podstrony miesięczne: „co wychodzi we wrześniu" to inne pytanie niż „co jest
// nowego" i inna fraza w wyszukiwarce. Lista liczy się z tych samych danych,
// więc nowy miesiąc pojawia się tu sam, gdy uzbiera PROG_SETOW premier.
const ilePerMiesiac = new Map();
for (const s of Object.values(sety)) {
  const k = String(s.premiera ?? '').slice(0, 7);
  if (/^\d{4}-\d{2}$/.test(k) && k >= '2026-01') ilePerMiesiac.set(k, (ilePerMiesiac.get(k) ?? 0) + 1);
}
const miesiace = [...ilePerMiesiac]
  .filter(([, n]) => n >= PROG_SETOW)
  .sort((a, b) => (a[0] < b[0] ? 1 : -1))
  .map(([k, n]) => ({ ...miesiac(k), ile: n }));
const wSerii = (x) => nowe.filter((s) => s.seria === x).length;
---
<Base title="Nowości LEGO — premiery i zapowiedzi" description={`Nowe zestawy LEGO: ${nowe.length} premier z ostatnich miesięcy i zapowiedzi. Ceny, liczba elementów, zdjęcia i nasza ocena, czy warto.`}>
  <h1 style="margin-top:28px">Nowości LEGO</h1>
  <p>Premiery z ostatnich tygodni i nadchodzące zapowiedzi. Aktualizujemy codziennie rano.</p>
  <p>Patrzysz dalej w przyszłość? Zebraliśmy <a href="/zapowiedzi-lego-2027/">wszystkie zapowiedzi LEGO na 2027 rok</a> — z podpowiedziami, które zestawy z obecnej oferty warto mieć, zanim znikną.</p>

  <nav class="mies-lista" aria-label="Premiery miesiąc po miesiącu">
    <span class="mies-lista__etykieta">Miesiąc po miesiącu:</span>
    {miesiace.map((x) => (
      <a href={x.sciezka}>{x.mianownik} {x.rok} <span class="mies-lista__ile">{x.ile}</span></a>
    ))}
  </nav>

  <FiltrSetow serie={serie} liczbaWSerii={wSerii} rzeczownik="nowości" />

  <div class="siatka siatka--nowosci" id="now-siatka">
    {nowe.map((s) => (
      <a
        class="karta set-karta"
        href={`/zestaw/${s.nr}/`}
        data-wiersz
        data-numer={s.nr}
        data-nazwa={s.nazwa}
        data-seria={s.seria}
      >
        {s.foto ? (
          <img class="miniatura" src={s.foto} alt={`LEGO ${s.nr} ${s.nazwa}`} loading="lazy" width="400" height="300" data-full={s.foto} data-podpis={`LEGO ${s.nr} ${s.nazwa} · Fot. LEGO`} />
        ) : (
          <div class="foto-brak" aria-hidden="true">
            <span class="studs"><i></i><i></i><i></i><i></i></span>
          </div>
        )}
        <span class="nr">LEGO {s.nr} {s.premiera > biezacy && <span class="badge-wkrotce">wkrótce</span>} {s.ekskluzyw && <span class="badge-ex">ekskluzyw</span>}</span>
        <h3>{s.nazwa}</h3>
        <span class="badge-seria">{s.seria}</span>
        <div class="cena-linia"><span class="cena">{s.cena_katalogowa ? fmt(s.cena_katalogowa) : 'cena nieujawniona'}</span><span class="za-klocek">{s.elementy ? `${s.elementy} el.` : ''}</span></div>
      </a>
    ))}
  </div>

  <div class="lightbox" id="lightbox" hidden>
    <img id="lb-img" src="" alt="" />
    <span class="lb-podpis" id="lb-podpis"></span>
  </div>
</Base>

<script>
  // Filtr serii i wyszukiwanie obsługuje wspólny FiltrSetow — tu zostaje
  // tylko lightbox, bo zdjęcia w nowościach są duże i warto je powiększać.
  // ── lightbox: klik w miniaturę powiększa zamiast przechodzić na stronę setu ──
  const $lb = document.getElementById('lightbox');
  const $lbImg = document.getElementById('lb-img');
  const $lbPodpis = document.getElementById('lb-podpis');

  document.getElementById('now-siatka').addEventListener('click', (e) => {
    const img = e.target.closest('img.miniatura[data-full]');
    if (!img) return;
    e.preventDefault();
    e.stopPropagation();
    $lbImg.src = img.dataset.full;
    $lbImg.alt = img.dataset.podpis || '';
    $lbPodpis.textContent = img.dataset.podpis || '';
    $lb.hidden = false;
    document.body.style.overflow = 'hidden';
  });

  function zamknij() {
    $lb.hidden = true;
    $lbImg.src = '';
    document.body.style.overflow = '';
  }
  $lb.addEventListener('click', zamknij);
  document.addEventListener('keydown', (e) => { if (e.key === 'Escape' && !$lb.hidden) zamknij(); });
</script>
