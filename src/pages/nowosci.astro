---
import { jsonldListingu } from '../lib/jsonld-listingu.js';
import Base from '../layouts/Base.astro';
import FiltrSetow from '../components/FiltrSetow.astro';
import TabelaSetow from '../components/TabelaSetow.astro';
import KaruzelaPropozycji from '../components/KaruzelaPropozycji.astro';
import sety from '../data/sety.json';
import ofertyFeed from '../data/oferty_feed.json';
import { urlZdjecia, opisSetu } from '../lib/media.js';
import { propozycjeDnia } from '../lib/losowanie.js';
import { maHub } from '../lib/huby.js';
import { hubIndeksowalny } from '../lib/seo.js';
import { miesiac, PROG_SETOW } from '../lib/miesiace.js';
import { statusNowosci } from '../lib/premiery.js';
import { odmien, najlepszaOferta, linkAfiliacyjny } from '../lib/oferty.js';
const ym = (d) => `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, '0')}`;
const teraz = new Date();
const odKiedy = ym(new Date(teraz.getFullYear(), teraz.getMonth() - 2, 1));
const biezacy = ym(teraz);
const feed = ofertyFeed?.sety ?? {};

// Dwa widoki zamiast jednego worka (ustalenie Marka 11.10.2026): zestawy, które
// już można kupić, mieszały się z zapowiedziami i czytelnik nie wiedział, co
// jest na półce, a na co trzeba poczekać.
//   Nowości    – premiera w bieżącym miesiącu lub wcześniej (ostatnie 3 miesiące),
//                jest oferta w sklepie, cena katalogowa i zdjęcie; bez kompletu
//                danych zestaw zostaje tylko na swojej karcie /zestaw/<nr>/.
//   Zapowiedzi – premiera w przyszłym miesiącu lub później: potwierdzone przez
//                LEGO i przecieki z rynku, każde z własną plakietką (pełna lista
//                przecieków ze źródłami: /przecieki/).
// Pole `zapowiedz` w sety.json nie decyduje – 76355 ma je od września, a jest
// w sprzedaży; rozstrzyga data premiery.
const etykietaMiesiaca = (p) => {
  const m = /^\d{4}-\d{2}$/.test(p) ? miesiac(p) : null;
  return m ? `${m.mianownik} ${m.rok}` : String(p);
};
const wszystkie = Object.entries(sety).map(([nr, s]) => ({
  nr,
  ...s,
  foto: urlZdjecia(nr, { sety, feed }),
  przeciek: statusNowosci(nr) === 'przeciek',
  wOfercie: (s.oferty?.length ?? 0) > 0 || Object.keys(feed[nr]?.oferty ?? {}).length > 0,
}));
const nowe = wszystkie
  .filter((s) => s.premiera >= odKiedy && s.premiera <= biezacy)
  .filter((s) => s.wOfercie && s.cena_katalogowa && s.foto && !s.przeciek)
  .sort((a, b) => (a.premiera > b.premiera ? -1 : a.premiera < b.premiera ? 1 : 0));
// sam rocznik („2027") ląduje za konkretnymi miesiącami tego roku
const kluczPremiery = (p) => (/^\d{4}$/.test(p) ? `${p}-99` : p);
const zapowiedzi = wszystkie
  .filter((s) => String(s.premiera ?? '') > biezacy || (s.przeciek && String(s.premiera ?? '') >= odKiedy))
  .map((s) => ({ ...s, k: kluczPremiery(String(s.premiera ?? '')) }))
  .sort((a, b) => (a.k < b.k ? -1 : a.k > b.k ? 1 : (b.cena_katalogowa ?? 0) - (a.cena_katalogowa ?? 0)));
const przecieki = zapowiedzi.filter((s) => s.przeciek).length;
const potwierdzone = zapowiedzi.length - przecieki;
const serie = [...new Set(nowe.map((s) => s.seria))].sort((a, b) => a.localeCompare(b, 'pl'));
const wSerii = (x) => nowe.filter((s) => s.seria === x).length;

// Widoki w układzie stron serii (11.10.2026): 129 boksów jeden pod drugim było
// nie do przejścia. Na górze karuzela 3×3 z premierami bieżącego miesiąca
// (losowanie dzienne, jak „Nasze propozycje" w seriach), pod nią tabela z
// filtrem: miesiąc premiery, seria, sortowanie, szukaj. Zapowiedzi – ta sama
// tabela, bez filtra (kilkanaście pozycji) i bez linków do sklepów.
const ymNum = (p) => Number(String(p).replace('-', '')) || null;
// W kolumnie statusu krótko: „Premiera" dla bieżącego miesiąca, starsze zwykłe
// „w sprzedaży" – miesiąc premiery stoi w wierszu pod nazwą zestawu.
const znaczekPremiery = (p) => (p === biezacy ? { klasa: 'badge-premiera', tekst: 'Premiera' } : undefined);
const wierszeNowosci = nowe.map((s) => {
  const oferta = najlepszaOferta(s.nr, { sety, feed }) ?? { sklep: 'lego', cena: s.cena_katalogowa, data: null };
  return {
    numer: s.nr,
    nazwa: s.nazwa,
    opis: opisSetu(s.nr, { sety })?.tekst ?? null,
    seria: s.seria,
    rok: ymNum(s.premiera),
    rokEtykieta: `premiera: ${etykietaMiesiaca(s.premiera)}`,
    elementy: s.elementy,
    zdjecie: s.foto,
    hub: maHub(s.nr),
    status: 'sprzedaz',
    znaczek: znaczekPremiery(s.premiera),
    oferta,
    link: linkAfiliacyjny(oferta.sklep, s.nr),
    cenaKatalogowa: s.cena_katalogowa,
  };
});
const wierszeZapowiedzi = zapowiedzi.map((s) => ({
  numer: s.nr,
  nazwa: s.nazwa,
  opis: opisSetu(s.nr, { sety })?.tekst ?? null,
  seria: s.seria,
  rok: null,
  rokEtykieta: `premiera: ${etykietaMiesiaca(s.premiera)}`,
  elementy: s.elementy,
  zdjecie: s.foto,
  hub: maHub(s.nr),
  znaczek: s.przeciek
    ? { klasa: 'badge-przeciek', tekst: 'przeciek z rynku' }
    : { klasa: 'badge-wkrotce', tekst: 'wkrótce' },
  // zapowiedź nie dostaje linku do sklepu – przycisk prowadziłby donikąd
  oferta: s.cena_katalogowa ? { sklep: null, cena: s.cena_katalogowa } : null,
  link: null,
  brakCeny: 'cena nieujawniona',
}));
const miesiaceNowosci = [...wierszeNowosci.reduce((m, w) => m.set(w.rok, (m.get(w.rok) ?? 0) + 1), new Map())]
  .sort((a, b) => b[0] - a[0])
  .map(([rok, ile]) => {
    const t = String(rok);
    return { rok, ile, etykieta: etykietaMiesiaca(`${t.slice(0, 4)}-${t.slice(4)}`) };
  });
const pulaKaruzeli = wierszeNowosci.filter((w) => w.hub && w.rok === ymNum(biezacy));
const karuzela = propozycjeDnia(pulaKaruzeli.length >= 3 ? pulaKaruzeli : wierszeNowosci.filter((w) => w.hub), 'nowosci', { najpierw: (w) => hubIndeksowalny(w.numer) })
  .map((w) => ({ numer: w.numer, nazwa: w.nazwa, zdjecie: w.zdjecie, cena: w.oferta.cena, elementy: w.elementy, ekskluzyw: Boolean(sety[w.numer]?.ekskluzyw) }));
const mBiezacy = miesiac(biezacy);

// Podstrony miesięczne: „co wychodzi we wrześniu" to inne pytanie niż „co jest
// nowego" i inna fraza w wyszukiwarce. Lista liczy się z tych samych danych,
// więc nowy miesiąc pojawia się tu sam, gdy uzbiera PROG_SETOW premier.
const ilePerMiesiac = new Map();
for (const s of Object.values(sety)) {
  const k = String(s.premiera ?? '').slice(0, 7);
  if (/^\d{4}-\d{2}$/.test(k) && k >= '2026-01') ilePerMiesiac.set(k, (ilePerMiesiac.get(k) ?? 0) + 1);
}
const miesiace = [...ilePerMiesiac]
  .filter(([, n]) => n >= PROG_SETOW)
  .sort((a, b) => (a[0] < b[0] ? 1 : -1))
  .map(([k, n]) => ({ ...miesiac(k), ile: n }));
const jsonld = jsonldListingu({ site: Astro.site, nazwa: 'Nowości i zapowiedzi LEGO', sciezka: '/nowosci/', pozycje: nowe.map((s) => ({ nazwa: `LEGO ${s.nr} ${s.nazwa}`, url: `/zestaw/${s.nr}/` })) });
---
<Base title="Nowości LEGO – premiery i zapowiedzi" jsonld={jsonld} description={`Nowe zestawy LEGO: ${nowe.length} premier z ostatnich miesięcy w sprzedaży i ${zapowiedzi.length} zapowiedzi. Ceny, liczba elementów, zdjęcia.`}>
  <h1 style="margin-top:28px">Nowości i zapowiedzi LEGO</h1>

  <div class="przelacznik" data-widok="nowosci">
    <button type="button" class="przelacznik__etyk" data-cel="nowosci" aria-controls="widok-nowosci" aria-pressed="true">Nowości LEGO <span class="przelacznik__ile">{nowe.length}</span></button>
    <button type="button" class="przelacznik__pstryk" role="switch" aria-checked="false" aria-label="Pokaż zapowiedzi zamiast nowości"><span aria-hidden="true"></span></button>
    <button type="button" class="przelacznik__etyk" data-cel="zapowiedzi" aria-controls="widok-zapowiedzi" aria-pressed="false">Zapowiedzi <span class="przelacznik__ile">{zapowiedzi.length}</span></button>
  </div>

  <section class="widok" id="widok-nowosci" aria-label="Nowości LEGO w sprzedaży">
    <p class="widok__wstep">Premiery z ostatnich trzech miesięcy, które już kupisz – w sklepie LEGO albo u innych sprzedawców. W tabeli najnowsze na górze, z najniższą ceną, jaką dziś widzimy.</p>
    <KaruzelaPropozycji pozycje={karuzela} tytul={pulaKaruzeli.length >= 3 ? `Premiery – ${mBiezacy.mianownik}` : 'Nasze propozycje'} etykieta="Wybrane premiery" />
    <FiltrSetow
      serie={serie}
      liczbaWSerii={wSerii}
      rzeczownik="nowości"
      lata={miesiaceNowosci}
      etykietaLat="Miesiąc premiery"
      sortowanie
    />
    <p class="disclosure">Linki przy cenach to linki afiliacyjne: kupując przez nie, wspierasz serwis i nie płacisz więcej. Kwota przy zestawie to ostatnia cena, jaką zobaczyliśmy w cenniku sklepu – wiążąca jest cena w koszyku.</p>
    <TabelaSetow wiersze={wierszeNowosci} />
  </section>

  <section class="widok" id="widok-zapowiedzi" aria-label="Zapowiedzi LEGO" hidden>
    <p class="widok__wstep">Zestawy, które jeszcze nie weszły do sprzedaży. Najbliższe premiery na górze; cena i liczba elementów często pojawiają się dopiero tuż przed startem.</p>
    <p class="nowosci-legenda">Dwa statusy: <span class="badge-wkrotce">wkrótce · potwierdzone przez LEGO</span> to zestawy z oficjalną kartą produktu na lego.com albo z komunikatu Grupy LEGO; <span class="badge-przeciek">przeciek z rynku</span> to informacje od dystrybutorów, ze sklepowych katalogów i od społeczności, których LEGO jeszcze nie potwierdziło – numer, nazwa, cena i liczba elementów mogą się zmienić. Gdy LEGO potwierdzi przeciek, zestaw zmienia status. Źródła i ocenę pewności każdego przecieku znajdziesz w dziale <a href="/przecieki/">Przecieki</a>.{zapowiedzi.length > 0 && <> Obecnie: {`${potwierdzone} ${odmien(potwierdzone, 'zapowiedź potwierdzona', 'zapowiedzi potwierdzone', 'zapowiedzi potwierdzonych')} i ${przecieki} ${odmien(przecieki, 'przeciek', 'przecieki', 'przecieków')}`}.</>} Zapowiedzi na cały kolejny rok: <a href="/zapowiedzi-lego-2027/">LEGO w 2027 roku</a>.</p>
    {zapowiedzi.length === 0 ? <p>Na razie nie ma zapowiedzi.</p> : <TabelaSetow wiersze={wierszeZapowiedzi} naglowekCeny="Cena katalogowa" filtrowalne={false} />}
  </section>

  <nav class="mies-lista" aria-label="Premiery miesiąc po miesiącu">
    <span class="mies-lista__etykieta">Miesiąc po miesiącu:</span>
    {miesiace.map((x) => (
      <a href={x.sciezka}>{x.mianownik} {x.rok} <span class="mies-lista__ile">{x.ile}</span></a>
    ))}
  </nav>

</Base>

<script>
  // ── przełącznik Nowości / Zapowiedzi; #zapowiedzi w adresie otwiera drugi widok ──
  const $przel = document.querySelector('.przelacznik');
  const $pstryk = $przel.querySelector('.przelacznik__pstryk');
  function ustawWidok(widok, zapisz) {
    const zap = widok === 'zapowiedzi';
    $przel.dataset.widok = widok;
    document.getElementById('widok-nowosci').hidden = zap;
    document.getElementById('widok-zapowiedzi').hidden = !zap;
    $pstryk.setAttribute('aria-checked', String(zap));
    $pstryk.setAttribute('aria-label', zap ? 'Pokaż nowości zamiast zapowiedzi' : 'Pokaż zapowiedzi zamiast nowości');
    $przel.querySelectorAll('.przelacznik__etyk').forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.cel === widok)));
    if (zapisz) history.replaceState(null, '', zap ? '#zapowiedzi' : location.pathname + location.search);
  }
  $przel.querySelectorAll('.przelacznik__etyk').forEach((b) => b.addEventListener('click', () => ustawWidok(b.dataset.cel, true)));
  $pstryk.addEventListener('click', () => ustawWidok($przel.dataset.widok === 'zapowiedzi' ? 'nowosci' : 'zapowiedzi', true));
  if (location.hash === '#zapowiedzi') ustawWidok('zapowiedzi', false);

</script>
