---
import Base from '../../layouts/Base.astro';
import TabelaCen from '../../components/TabelaCen.astro';
import sety from '../../data/sety.json';
import { zdjecieSetu } from '../../lib/media.js';

export function getStaticPaths() {
  return Object.keys(sety).map((nr) => ({ params: { nr } }));
}

const { nr } = Astro.params;
const s = sety[nr];
const fmt = (c) => c.toLocaleString('pl-PL', { minimumFractionDigits: 2 }) + ' zł';
const zaKlocek = (s.cena_katalogowa / s.elementy).toFixed(2).replace('.', ',');
const najlepsza = Math.min(...s.oferty.map((o) => o.cena));
const zdj = s.zdjecia ?? null;
// zdjęcie z fallbackiem: sety.json -> zdjecia.json (mapa zbiorcza)
const foto = zdjecieSetu(nr, { sety });

const jsonld = {
  '@context': 'https://schema.org',
  '@type': 'Product',
  name: `LEGO ${nr} ${s.nazwa}`,
  sku: nr,
  brand: { '@type': 'Brand', name: 'LEGO' },
  description: s.opis,
  ...(foto?.url ? { image: new URL(foto.url, Astro.site).href } : {}),
  offers: {
    '@type': 'AggregateOffer',
    priceCurrency: 'PLN',
    lowPrice: najlepsza,
    highPrice: Math.max(...s.oferty.map((o) => o.cena)),
    offerCount: s.oferty.length,
    availability: 'https://schema.org/InStock',
  },
};
---
<Base
  title={`LEGO ${nr} ${s.nazwa} — cena, promocje, gdzie kupić najtaniej`}
  description={`LEGO ${nr} ${s.nazwa}: ${s.elementy} elementów, cena katalogowa ${fmt(s.cena_katalogowa)}. Sprawdzamy, gdzie kupisz najtaniej. Aktualnie od ${fmt(najlepsza)}.`}
  jsonld={jsonld}
>
  <article>
    <div class="set-hero">
      <div>
        {foto?.url ? (
          <figure class="foto-okno">
            <img src={foto.url} alt={`LEGO ${nr} ${s.nazwa} — zdjęcie zestawu`} width="800" height="800" />
          </figure>
        ) : (
          <div class="foto-placeholder">
            <span class="studs" aria-hidden="true"><i></i><i></i><i></i><i></i></span>
            <span>LEGO {nr}</span>
            <span>zdjęcie wkrótce</span>
          </div>
        )}
        {foto?.zrodlo && <p class="zrodlo-foto">Fot.: {foto.zrodlo}</p>}
      </div>
      <div>
        <p style="margin-top:0"><span class="badge-seria">{s.seria}</span> {s.ekskluzyw && <span class="badge-ex">ekskluzyw LEGO.com</span>}</p>
        <h1>LEGO {nr} {s.nazwa}</h1>
        <div class="deal-meta" style="margin-bottom: 8px">
          <span><strong>{s.elementy}</strong> elementów</span>
          <span><strong>{zaKlocek} zł</strong> za klocek</span>
          <span>wiek <strong>{s.wiek}</strong></span>
          <span>premiera <strong>{s.premiera}</strong></span>
          <span>cena katalogowa <strong>{fmt(s.cena_katalogowa)}</strong></span>
        </div>
        <p class="prose">{s.opis}</p>
      </div>
    </div>

    {zdj?.galeria?.length > 0 && (
      <section class="sekcja" style="margin-top:20px">
        <h2>Galeria</h2>
        <div class="galeria">
          {zdj.galeria.map((g, i) => (
            <a href={g} target="_blank" rel="noopener">
              <img src={g} alt={`LEGO ${nr} ${s.nazwa} — zdjęcie ${i + 2}`} loading="lazy" width="400" height="400" />
            </a>
          ))}
        </div>
      </section>
    )}

    <TabelaCen nr={nr} oferty={s.oferty} cenaKatalogowa={s.cena_katalogowa} />
    <p class="disclosure">Linki „Sprawdź w sklepie" są linkami afiliacyjnymi — kupując przez nie, wspierasz serwis, nie płacąc więcej. Najtańsza oferta zawsze na górze.</p>

    <div class="persony">
      <div class="karta persona">
        <h3>👨‍👩‍👧 Dla rodzica</h3>
        <p>{s.dla_rodzica}</p>
      </div>
      <div class="karta persona afol">
        <h3>🧱 Dla kolekcjonera</h3>
        <p>{s.dla_afol}</p>
      </div>
    </div>
  </article>
</Base>
