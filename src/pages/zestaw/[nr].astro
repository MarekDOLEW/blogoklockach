---
import Base from '../../layouts/Base.astro';
import TabelaCen from '../../components/TabelaCen.astro';
import Okruszki from '../../components/Okruszki.astro';
import ObserwujCene from '../../components/ObserwujCene.astro';
import PasekCeny from '../../components/PasekCeny.astro';
import sety from '../../data/sety.json';
import ofertyFeed from '../../data/oferty_feed.json';
import { zdjecieSetu, opisSetu } from '../../lib/media.js';
import karty from '../../data/karty_setow.json';
import galerie from '../../data/galerie.json';
import { wpisKatalogu } from '../../lib/katalog.js';
import { numeryHubow, wycofanieSetu } from '../../lib/huby.js';
import { artykulyZestawu } from '../../lib/artykuly-setow.js';
import { premieraSetu, zapowiedz, przeciek as przeciekSetu } from '../../lib/premiery.js';
import { eolWLego, eolPotwierdzony, statusWycofania } from '../../lib/status.js';
import { fmtElementy, polaczOferty, cenaKatalogowaSetu, nazwaSklepu, fmtCena } from '../../lib/oferty.js';
import { hubIndeksowalny } from '../../lib/seo.js';
import { podobneZSerii } from '../../lib/seria-huby.js';
import { dataPl } from '../../lib/daty.js';
import cenyBaza from '../../data/ceny_baza.json';

export function getStaticPaths() {
  return [...numeryHubow].map((nr) => ({ params: { nr } }));
}

const { nr } = Astro.params;
const fmt = (c) => c.toLocaleString('pl-PL', { minimumFractionDigits: 2 }) + ' zł';

// Pełny hub (sety.json, redakcyjne opisy) albo lekki – złożony z katalogu i feedów.
const s = sety[nr] ?? null;
const kat = wpisKatalogu(nr);
const wycofanie = wycofanieSetu(nr);
const feedOferta = ofertyFeed?.sety?.[nr] ?? null;

// „{?}" to placeholder Bricksetu dla zestawu bez ogłoszonej nazwy — nie może
// trafić do tytułu strony ani JSON-LD (audyt 22.09: trzy huby „LEGO {?}").
const bezPlaceholdera = (n) => (n && String(n).trim() !== '{?}' ? n : undefined);
const nazwa = bezPlaceholdera(s?.nazwa) ?? bezPlaceholdera(kat?.nazwa) ?? bezPlaceholdera(wycofanie?.nazwa) ?? 'bez ogłoszonej nazwy';
const seria = s?.seria ?? kat?.seria ?? wycofanie?.seria;
const elementy = s?.elementy ?? kat?.elementy ?? wycofanie?.elementy ?? null;
const rok = kat?.rok ?? null;
const cenaKatalogowa = cenaKatalogowaSetu(nr, { sety });

// redakcyjne oferty + ceny z feedów sklepowych w jednej tabeli (dubel sklepu -> niższa cena)
const oferty = polaczOferty(s?.oferty ?? [], feedOferta, nr);
// Ceneo to porównywarka, nie sklep: tabela i listingi (najlepszaOferta) go pomijają,
// więc title/meta/JSON-LD też muszą — audyt 15.09.2026: 737 hubów obiecywało w Google
// cenę Ceneo niższą niż najtańszy wiersz tabeli (10281: meta 139,47 zł, tabela 149 zł).
const ofertyBezCeneo = oferty.filter((o) => o.sklep !== 'ceneo');
const najlepsza = ofertyBezCeneo.length ? Math.min(...ofertyBezCeneo.map((o) => o.cena)) : null;

const zdj = s?.zdjecia ?? null;
// zdjęcie z fallbackiem: sety.json -> feed -> zdjecia.json; wycofania mają czasem własne
const foto =
  zdjecieSetu(nr, { sety, feed: ofertyFeed?.sety ?? {} }) ??
  (wycofanie?.zdjecie ? { url: wycofanie.zdjecie, zrodlo: null } : null);

// kolejność: opis redakcyjny -> uwagi z listy wycofań (pisane ręcznie, aktualne)
// -> opis generowany; generator bywa nieaktualny (np. "nie ma go w sklepach"
// o secie, który LEGO wciąż sprzedaje), więc stoi na końcu
// Karta katalogowo-sprzedażowa (redakcja) – pełny opis pod tabelą cen.
const karta = karty[nr] ?? null;
// Nasze teksty o tym zestawie (recenzja, zapowiedź, porównanie) – linkujemy je
// nad tabelą cen, bo to informacja potrzebna PRZED decyzją zakupową.
const naszeArtykuly = artykulyZestawu(nr);
// Zdjęcia slajdera: /img/<nr>-N.jpg serwuje worker z galerie.json
const galeriaSlajder = galerie[nr] ?? [];
// Gdy jest karta, generowany opis ustępuje – inaczej te same fakty pojawiłyby
// się dwa razy, a generator bywa nieaktualny.
const opis = s?.opis ?? wycofanie?.uwagi ?? (karta ? null : opisSetu(nr, { sety })?.tekst) ?? null;

// LEGO zakończyło sprzedaż (EOL) – jedna definicja dla całego serwisu
// (src/lib/status.js); liczy się także dla pełnych hubów z sety.json, bo
// śledzony zestaw też potrafi zejść z lego.com, a tabela cen musi to pokazać
const eol = eolWLego(nr);
// „EOL – koniec produkcji" tylko gdy lista wycofań to potwierdza; sam status
// katalogu (z listingu lego.pl albo importu) znaczy jedynie „brak w lego.pl"
const eolPewny = eol && eolPotwierdzony(nr);
// dystrybucja wyłączna LEGO: flaga z sety.json (ręczna) albo z katalogu (listing lego.pl, co tydzień)
const ekskluzyw = Boolean(s?.ekskluzyw || kat?.ekskluzyw);
const wycof = statusWycofania(nr);
// oferty sklepów poza LEGO – po EOL to one decydują, czy zestaw da się jeszcze kupić
const ofertySklepowe = oferty.filter((o) => o.sklep !== 'lego' && o.sklep !== 'ceneo');

// zapowiedź: premiera w przyszłym miesiącu lub później. Datę bierzemy też
// z karty redakcyjnej i z rocznika katalogu, bo zestaw zapowiedziany zwykle
// nie ma jeszcze wpisu w sety.json, a i tak nie może dostać tabeli cen.
const premiera = premieraSetu(nr);
const wkrotce = zapowiedz(nr);
// zapowiedź potwierdzona przez LEGO kontra przeciek z rynku (src/lib/premiery.js)
const przeciek = przeciekSetu(nr);
// cena katalogowa bywa nieogłoszona (premiery, zestawy promocyjne) – wtedy
// mówimy o tym wprost, zamiast zostawiać puste miejsce
const cenaNieznana = !cenaKatalogowa;
// zestaw bez polskiej ceny katalogowej z natury (ekskluzyw LEGO House/LEGOLAND,
// prezent GWP, BrickLink Designer Program) – pole `bez_rrp` z powodem w sety.json
// albo katalog.json (Cowork 23.09.2026). Wtedy nie obiecujemy, że cenę „podamy”.
const bezRrp = s?.bez_rrp || kat?.bez_rrp || null;

const sciezkaSerii = seria
  ? `/serie/${seria.toLowerCase().normalize('NFD').replace(/[\u0300-\u036f]/g, '').replace(/\s+/g, '-')}/`
  : null;

const okruszki = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'tylkoklocki.pl', item: 'https://tylkoklocki.pl/' },
    ...(seria ? [{ '@type': 'ListItem', position: 2, name: `LEGO ${seria}`, item: new URL(sciezkaSerii, Astro.site).href }] : []),
    { '@type': 'ListItem', position: seria ? 3 : 2, name: `LEGO ${nazwa} (${nr})` },
  ],
};

const jsonld = {
  '@context': 'https://schema.org',
  '@type': 'Product',
  name: `LEGO ${nazwa} (${nr})`,
  sku: nr,
  brand: { '@type': 'Brand', name: 'LEGO' },
  ...(opis ? { description: opis } : karta?.akapity?.[0] ? { description: String(karta.akapity[0]).replace(/<[^>]+>/g, '').slice(0, 300) } : {}),
  ...(foto?.url ? { image: new URL(foto.url, Astro.site).href } : {}),
  ...(ofertyBezCeneo.length
    ? {
        offers: {
          '@type': 'AggregateOffer',
          priceCurrency: 'PLN',
          lowPrice: najlepsza,
          highPrice: Math.max(...ofertyBezCeneo.map((o) => o.cena)),
          offerCount: ofertyBezCeneo.length,
          url: new URL(`/zestaw/${nr}/`, Astro.site).href,
          availability: eol && ofertySklepowe.length === 0 ? 'https://schema.org/Discontinued' : 'https://schema.org/InStock',
        },
      }
    : {}),
};

// Tagi zestawu: krótkie etykiety z danych, które i tak pokazujemy niżej.
// Mają pomóc czytelnikowi ocenić zestaw jednym rzutem oka („18+", „duży
// zestaw"), a nie mnożyć bytów – dlatego wyliczamy je, zamiast wpisywać ręcznie.
const tagi = [
  s?.wiek === '18+' || kat?.wiek === '18+' ? 'Dla dorosłych' : null,
  elementy && elementy >= 2000 ? 'Duży zestaw' : null,
  elementy && elementy <= 300 ? 'Mały zestaw' : null,
  cenaKatalogowa && cenaKatalogowa <= 100 ? 'Do 100 zł' : null,
  wycof && wycof.etap !== 'wycofany' ? 'Znika z rynku' : null,
  eol && ofertySklepowe.length > 0 ? 'Ostatnie sztuki w sklepach' : null,
].filter(Boolean);

// Okruszki widoczne – ta sama ścieżka co w danych strukturalnych powyżej,
// żeby to, co widzi czytelnik, i to, co czyta Google, nigdy się nie rozjechało.
const sciezkaOkruszkow = [
  { nazwa: 'Start', href: '/' },
  ...(seria ? [{ nazwa: `LEGO ${seria}`, href: sciezkaSerii }] : []),
  { nazwa: `LEGO ${nr}` },
];

// FAQ z karty trafia do danych strukturalnych – realna treść, na której Google
// może oprzeć ocenę jakości podstrony, a nie sam szablon cenowy.
const faqJsonld = karta?.faq?.length
  ? {
      '@context': 'https://schema.org',
      '@type': 'FAQPage',
      mainEntity: karta.faq.map((f) => ({
        '@type': 'Question',
        name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: f.a.replace(/<[^>]+>/g, '') },
      })),
    }
  : null;

// Cienkie huby (sam szablon cenowy bez tekstu, bez naszego artykułu, stary
// zestaw) dostają noindex, follow – strona działa i przekazuje moc dalej, ale
// nie zjada budżetu crawlowania. Reguła i progi: src/lib/seo.js; ta sama
// funkcja decyduje o obecności huba w sitemap-zestawy.xml.
const indeksowalny = hubIndeksowalny(nr);

// Najniższa cena, jaką zanotował Łowca (ceny_baza.json) – jedyna „historia
// ceny", jaką mamy w danych (pełnych szeregów czasowych nie zbieramy).
// Pokazujemy ją tylko, gdy jest niższa od dzisiejszej najlepszej oferty:
// wtedy niesie informację, że bywało taniej i przy jakiej cenie.
const minimum = cenyBaza[nr]?.najnizsza_cena
  ? { cena: cenyBaza[nr].najnizsza_cena, data: cenyBaza[nr].najnizsza_data, sklep: cenyBaza[nr].najnizsza_sklep }
  : null;
const minimumWarte = minimum && najlepsza && minimum.cena < najlepsza;

// Podobne zestawy tej serii pod szczegółami – 4–6 pozycji losowanych z ziarnem
// dnia (src/lib/seria-huby.js): linkowanie wewnętrzne między hubami, a dla
// czytelnika podpowiedź „co jeszcze z tej serii" z ceną i zdjęciem.
const podobne = podobneZSerii(seria, nr);

// tytuł zwięzły – Google obcina ~60 znaków, sufiks domeny dokłada Base.
// Długie nazwy (np. bolidy F1 z pełną nazwą zespołu) skracamy do ~40 znaków na
// granicy słowa; audyt 15.09.2026 znalazł tytuły po 122 znaki na 2673 stronach.
const nazwaKrotka = nazwa.length <= 40 ? nazwa : `${nazwa.slice(0, 40).replace(/\s+\S*$/, '')}…`;
// Nazwa przed numerem (decyzja Marka 15.09.2026): ludzie szukają „lego gustav
// klimt", „sagrada familia lego" — numer zostaje w nawiasie dla kolekcjonerów.
const tytul = najlepsza
  ? `LEGO ${nazwaKrotka} (${nr}) – cena i promocje`
  : `LEGO ${nazwaKrotka} (${nr})${eol ? ' – wycofany (EOL)' : ''}`;
// Opis meta zaczyna się od ceny i liczby sklepów — GSC 15.09.2026: huby na
// pozycjach 7–12 miały 0% CTR obok sklepów, które pokazują cenę w wyniku.
const liczbaSklepow = new Set(ofertyBezCeneo.map((o) => o.sklep)).size;
// Gdy najtaniej jest po cenie katalogowej (albo drożej), „od X w 1 sklepie" brzmi
// jak okazja, którą nie jest — wtedy mówimy wprost, że promocji jeszcze nie ma.
const rabatMeta = cenaKatalogowa && najlepsza ? Math.round((1 - najlepsza / cenaKatalogowa) * 100) : 0;
const ogonMeta = `LEGO ${nr} ${nazwa}${elementy ? `, ${elementy} elementów` : ''} – porównanie cen, ${bezRrp ? 'bez polskiej ceny katalogowej' : 'rabat liczony od RRP'}, dla rodzica i dla kolekcjonera.`;
const opisMeta = najlepsza
  ? bezRrp
    ? `Od ${fmt(najlepsza)} w ${liczbaSklepow} ${liczbaSklepow === 1 ? 'sklepie' : 'sklepach'} – to rynek wtórny, nie promocja. ${ogonMeta}`
    : rabatMeta >= 3
    ? `Od ${fmt(najlepsza)} w ${liczbaSklepow} ${liczbaSklepow === 1 ? 'sklepie' : 'sklepach'} (${rabatMeta}% poniżej ceny katalogowej ${fmt(cenaKatalogowa)}). ${ogonMeta}`
    : cenaKatalogowa
      ? `Cena katalogowa ${fmt(cenaKatalogowa)}, promocji jeszcze nie ma – sprawdzamy codziennie w ${liczbaSklepow} ${liczbaSklepow === 1 ? 'sklepie' : 'sklepach'}. ${ogonMeta}`
      : `Od ${fmt(najlepsza)} w ${liczbaSklepow} ${liczbaSklepow === 1 ? 'sklepie' : 'sklepach'}. ${ogonMeta}`
  : `LEGO ${nr} ${nazwa}${seria ? ` z serii ${seria}` : ''}${elementy ? `: ${elementy} elementów` : ''}${rok ? `, rocznik ${rok}` : ''}.${eol ? ' Zestaw wycofany z produkcji (EOL).' : ''}`;
---
<Base title={tytul} description={opisMeta} jsonld={[jsonld, okruszki, ...(faqJsonld ? [faqJsonld] : [])]} ogImage={foto?.url ?? undefined} noindex={!indeksowalny}>
  <Okruszki sciezka={sciezkaOkruszkow} />
  <article>
    <div class="set-hero">
      <div>
        {galeriaSlajder.length > 0 ? (
          <figure class="foto-okno slajder" aria-label={`Zdjęcia zestawu LEGO ${nr}`}>
            <div class="slajder-tasma" id={`tasma-${nr}`}>
              <img id={`kl-${nr}-0`} src={foto?.url ?? `/img/${nr}.jpg`} alt={`LEGO ${nr} ${nazwa} – zdjęcie główne`} width="800" height="800" />
              {galeriaSlajder.map((_, i) => (
                <img id={`kl-${nr}-${i + 1}`} src={`/img/${nr}-${i + 1}.jpg`} alt={`LEGO ${nr} ${nazwa} – zdjęcie ${i + 2}`} loading="lazy" width="800" height="800" />
              ))}
            </div>
          </figure>
        ) : foto?.url ? (
          <figure class="foto-okno">
            <img src={foto.url} alt={`LEGO ${nr} ${nazwa} – zdjęcie zestawu`} width="800" height="800" />
          </figure>
        ) : (
          <div class="foto-placeholder">
            <span class="studs" aria-hidden="true"><i></i><i></i><i></i><i></i></span>
            <span>LEGO {nr}</span>
            <span>zdjęcie wkrótce</span>
          </div>
        )}
        {galeriaSlajder.length > 0 && (
          <>
            <div class="miniatury" data-tasma={`tasma-${nr}`}>
              <a href={`#kl-${nr}-0`} class="miniatura-btn" aria-label="Zdjęcie 1">
                <img src={foto?.url ?? `/img/${nr}.jpg`} alt="" loading="lazy" width="80" height="80" />
              </a>
              {galeriaSlajder.map((_, i) => (
                <a href={`#kl-${nr}-${i + 1}`} class="miniatura-btn" aria-label={`Zdjęcie ${i + 2}`}>
                  <img src={`/img/${nr}-${i + 1}.jpg`} alt="" loading="lazy" width="80" height="80" />
                </a>
              ))}
            </div>
            <p class="slajder-info">{galeriaSlajder.length + 1} zdjęć – przesuń palcem lub kliknij miniaturę</p>
          </>
        )}
        {foto?.zrodlo && <p class="zrodlo-foto">Fot.: {foto.zrodlo}</p>}
      </div>
      <div>
        <p style="margin-top:0" class="set-plakietki">
          {seria && <a class="badge-seria" href={sciezkaSerii}>{seria}</a>}
          {wkrotce && !przeciek && <span class="badge-wkrotce">wkrótce – zapowiedź potwierdzona przez LEGO</span>}
          {przeciek && <a class="badge-przeciek" href="/przecieki/" title="Informacja nieoficjalna – LEGO nie potwierdziło jeszcze tego zestawu; źródło i ocena pewności w dziale Przecieki">zapowiedź – przeciek z rynku</a>}
          {ekskluzyw && <span class="badge-ex">ekskluzyw LEGO.com</span>}
          {eol && (eolPewny
            ? <span class="badge-status badge-status--eol" title="End of life – LEGO zakończyło produkcję i sprzedaż tego zestawu">EOL – koniec produkcji w LEGO</span>
            : <span class="badge-status badge-status--eol" title="Zestawu nie ma w sklepie lego.pl; inne sklepy mogą mieć zapasy">brak w lego.pl</span>)}
          {wycof && wycof.etap !== 'wycofany' && (
            <span class={`badge-status ${wycof.etap === 'potwierdzone' ? 'badge-status--pewny' : 'badge-status--prognoza'}`}>wycofanie: {wycof.etykieta}</span>
          )}
          {tagi.map((t) => <span class="badge-tag">{t}</span>)}
        </p>
        <h1>LEGO {nazwa} <span class="h1-numer">({nr})</span></h1>
        <div class="deal-meta" style="margin-bottom: 8px">
          {elementy && <span><strong>{fmtElementy(elementy)}</strong> elementów</span>}
          {s?.cena_katalogowa && s?.elementy && <span><strong>{(s.cena_katalogowa / s.elementy).toFixed(2).replace('.', ',')} zł</strong> za klocek</span>}
          {s?.wiek && <span>wiek <strong>{s.wiek}</strong></span>}
          {premiera ? <span>premiera <strong>{premiera}</strong></span> : rok && <span>rocznik <strong>{rok}</strong></span>}
          {cenaKatalogowa
            ? <span>cena katalogowa <strong>{fmt(cenaKatalogowa)}</strong></span>
            : bezRrp
              ? <span>cena katalogowa <strong>brak</strong> (zestaw bez polskiego cennika)</span>
              : <span>cena katalogowa <strong>nieogłoszona</strong> (podamy, gdy LEGO ją poda)</span>}
          {/* ocena tylko przy sensownej próbie – kilka głosów to szum, nie dowód (audyt CRO 25.09) */}
          {s?.brickset?.ocena && (s.brickset.glosy ?? 0) >= 20 && (
            <span title="Ocena użytkowników serwisu Brickset i liczba osób, które mają ten zestaw w kolekcji">
              Brickset <strong>{String(s.brickset.ocena).replace('.', ',')}/5</strong>
              {s.brickset.glosy && <>{` (${s.brickset.glosy} ocen)`}</>}{s.brickset.posiadacze && <>{', '}<strong>{fmtElementy(s.brickset.posiadacze)}</strong> w kolekcjach</>}
            </span>
          )}
        </div>
        {najlepsza && !przeciek && !wkrotce && <PasekCeny nr={nr} oferty={ofertyBezCeneo} cenaKatalogowa={cenaKatalogowa} wariant="gora" />}
        {opis && <p class="prose">{opis}</p>}
        {wycof && wycof.etap !== 'wycofany' && (
          <p class="karta" style="padding:10px 14px; font-size:0.92rem;">
            <strong>Zestaw na liście wycofań:</strong> znika {wycof.kiedy}
            {wycof.etap === 'potwierdzone'
              ? ' – termin potwierdzony przez LEGO.'
              : ' – to prognoza rynku (zgodne zapowiedzi branżowe); LEGO nie potwierdziło jeszcze terminu.'}
            {' '}<a href={`/wycofania/?q=${nr}`}>Zobacz na liście wycofań →</a>
          </p>
        )}
        {eol && (
          <p class="karta" style="padding:10px 14px; font-size:0.92rem;">
            <strong>{eolPewny ? 'LEGO zakończyło produkcję tego zestawu (EOL).' : 'Tego zestawu nie ma już w sklepie lego.pl.'}</strong>
            {ofertySklepowe.length > 0
              ? ' Inne sklepy sprzedają jeszcze zapasy – ceny poniżej to ostatnie sztuki, po ich wyczerpaniu zostaje rynek wtórny.'
              : ' Żaden ze śledzonych sklepów nie ma go dziś w cenniku – zostaje rynek wtórny (Allegro, OLX).'}
          </p>
        )}
      </div>
    </div>

    {naszeArtykuly.length > 0 && (
      <p class="karta odsylacz-artykul">
        {naszeArtykuly.map((a, i) => (
          <a href={a.url}>
            <span class="badge-seria">{a.etykieta}</span>
            <span class="odsylacz-artykul__tytul">{a.tytul}</span>
            <span aria-hidden="true"> →</span>
            {i < naszeArtykuly.length - 1 && <br />}
          </a>
        ))}
      </p>
    )}

    {zdj?.galeria?.length > 0 && (
      <section class="sekcja" style="margin-top:20px">
        <h2>Galeria</h2>
        <div class="galeria">
          {zdj.galeria.map((g, i) => (
            <a href={g} target="_blank" rel="noopener">
              <img src={g} alt={`LEGO ${nr} ${nazwa} – zdjęcie ${i + 2}`} loading="lazy" width="400" height="400" />
            </a>
          ))}
        </div>
      </section>
    )}

    {wkrotce && oferty.length === 0 ? (
      <p class="karta" style="padding: 14px 18px; margin: 18px 0;">
        <strong>Zapowiedź:</strong> premiera {premiera}.
        {przeciek && ' To przeciek z rynku – Grupa LEGO nie potwierdziła jeszcze tego zestawu, więc numer, nazwa, cena i liczba elementów mogą się zmienić. Gdy LEGO go ujawni, oznaczymy zapowiedź jako potwierdzoną.'}
        {cenaNieznana && ' Cena katalogowa nie została jeszcze ogłoszona – podamy ją, gdy LEGO ją poda.'}
        {' '}Gdy zestaw trafi do sklepów, w tym miejscu pojawi się porównanie cen.
      </p>
    ) : oferty.length > 0 || cenaKatalogowa ? (
      <div id="ceny">
        {cenaNieznana && bezRrp && (
          <p class="karta" style="padding: 12px 16px; margin: 18px 0 0;">
            <strong>Bez polskiej ceny katalogowej:</strong> {bezRrp}. Rabatu nie liczymy – ceny poniżej to
            rynek wtórny, nie promocja.
          </p>
        )}
        {cenaNieznana && !bezRrp && (
          <p class="karta" style="padding: 12px 16px; margin: 18px 0 0;">
            <strong>Cena katalogowa nieogłoszona.</strong> LEGO nie podało jeszcze sugerowanej ceny tego zestawu –
            uzupełnimy ją, gdy tylko się pojawi. Poniżej ceny sklepów, o ile już go mają.
          </p>
        )}
        {ekskluzyw && !eol && (
          <p class="karta" style="padding: 12px 16px; margin: 18px 0 0;">
            <strong>Zestaw ekskluzywny – sprzedaje go tylko LEGO.</strong> Nie czekaj na promocję w innych sklepach,
            bo nie trafia do ich cenników; okazje to promocje samego LEGO (punkty Insiders, gratisy, sezonowe obniżki).
            {' '}<a href="/ekskluzywne/">Wszystkie ekskluzywy →</a>
          </p>
        )}
        <TabelaCen nr={nr} oferty={oferty} cenaKatalogowa={cenaKatalogowa} dodajLego={!eol && !wkrotce} eolLego={eol} eolPewny={eolPewny} />
        {minimumWarte && (
          <p class="set-minimum">
            Najniższa cena, jaką zanotowaliśmy: <strong>{fmt(minimum.cena)}</strong>
            {minimum.sklep && <> ({nazwaSklepu(minimum.sklep)}{minimum.data && <>, {dataPl(minimum.data)}</>})</>}
            {!minimum.sklep && minimum.data && <> ({dataPl(minimum.data)})</>}
            {' '}– dziś jest o {fmt(najlepsza - minimum.cena)} drożej.
          </p>
        )}
        <p class="disclosure">Przyciski z nazwą sklepu i strzałką są linkami afiliacyjnymi – kupując przez nie, wspierasz serwis, nie płacąc więcej. Najtańszy sklep zawsze na górze; Ceneo stoi osobno na końcu, bo to porównywarka, nie sklep – jego cena może być niższa niż w wierszach wyżej.</p>
      </div>
    ) : (
      <p class="karta" id="ceny" style="padding: 14px 18px; margin: 18px 0;">Nie widzimy tego zestawu w żadnym ze śledzonych sklepów{eol ? ' – LEGO zakończyło jego sprzedaż (EOL), pozostaje rynek wtórny (Allegro, OLX)' : ''}. Gdy oferta się pojawi, cena będzie widoczna w tym miejscu.</p>
    )}

    {!przeciek && <ObserwujCene nr={nr} eol={eol} />}

    {karta && (
      <section class="sekcja karta-setu" style="margin-top:24px">
        <h2>LEGO {nr} {karta.nazwa}</h2>
        {karta.akapity.map((a) => <p class="prose" set:html={a} />)}
        {karta.metryka && Object.keys(karta.metryka).length > 0 && (
          <>
            <h3 style="margin-top:22px">Metryka zestawu</h3>
            <div class="metryka-wrap">
              <table class="metryka-setu">
                <tbody>
                  {Object.entries(karta.metryka).map(([pole, wartosc]) => (
                    <tr>
                      <th scope="row">{pole}</th>
                      <td>{wartosc}</td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          </>
        )}
        {karta.faq?.length > 0 && (
          <>
            <h3 style="margin-top:22px">Najczęstsze pytania</h3>
            <dl class="faq-setu">
              {karta.faq.map((f) => (
                <>
                  <dt>{f.q}</dt>
                  <dd set:html={f.a} />
                </>
              ))}
            </dl>
          </>
        )}
      </section>
    )}


    {najlepsza && !przeciek && !wkrotce && <PasekCeny nr={nr} oferty={ofertyBezCeneo} cenaKatalogowa={cenaKatalogowa} wariant="dol" />}

    {podobne.length > 0 && (
      <section class="sekcja podobne" style="margin-top:28px" aria-label={`Podobne zestawy z serii ${seria}`}>
        <div class="sekcja-head">
          <span class="studs studs--granat" aria-hidden="true"><i></i><i></i><i></i><i></i></span>
          <h2>Podobne zestawy z serii {seria}</h2>
        </div>
        <div class="siatka siatka--podobne">
          {podobne.map((z) => (
            <a class="karta set-karta set-karta--mini" href={`/zestaw/${z.nr}/`} target="_blank" rel="noopener">
              {z.zdjecie
                ? <img class="miniatura" src={z.zdjecie} alt={`LEGO ${z.nr} ${z.nazwa}`} loading="lazy" width="300" height="225" />
                : <span class="foto-brak" aria-hidden="true"><span class="studs studs--granat"><i></i><i></i><i></i><i></i></span></span>}
              <span class="nr">LEGO {z.nr}{z.eolLego && <> <span class="tag-eol" title={z.eolPewny ? 'EOL – LEGO zakończyło produkcję' : 'brak w sklepie lego.pl'}>{z.eolPewny ? 'EOL' : 'brak w lego.pl'}</span></>}</span>
              <h3>{z.nazwa}</h3>
              <div class="cena-linia">
                <span class="cena">{z.cena ? `od ${fmtCena(z.cena)}` : z.cenaKatalogowa && !z.eolLego ? fmtCena(z.cenaKatalogowa) : 'sprawdź cenę'}</span>
              </div>
            </a>
          ))}
        </div>
        {sciezkaSerii && <p style="margin-top:14px"><a class="podobne-cala-seria" href={sciezkaSerii}>Zobacz całą serię {seria} →</a></p>}
      </section>
    )}

    {s ? (
      <div class="persony">
        <div class="karta persona">
          <h3>👨‍👩‍👧 Dla rodzica</h3>
          <p>{s.dla_rodzica}</p>
        </div>
        <div class="karta persona afol">
          <h3>🧱 Dla kolekcjonera</h3>
          <p>{s.dla_afol}</p>
        </div>
      </div>
    ) : (
      seria && (
        <p style="margin-top: 20px"><a href={`/serie/${seria.toLowerCase().normalize('NFD').replace(/[\u0300-\u036f]/g, '').replace(/\s+/g, '-')}/`}>← Wszystkie zestawy serii {seria}</a></p>
      )
    )}
      {najlepsza && !przeciek && !wkrotce && <PasekCeny nr={nr} oferty={ofertyBezCeneo} cenaKatalogowa={cenaKatalogowa} wariant="przyklejony" />}
    <script>
      // Pasek przyklejony (telefon): widoczny, gdy tabela cen wyjechała poza ekran
      // w górę, chowa się, gdy tabela lub pasek dolny jest w kadrze.
      const pasek = document.querySelector<HTMLElement>('[data-pasek="przyklejony"]');
      const ceny = document.getElementById('ceny');
      const dol = document.querySelector<HTMLElement>('[data-pasek="dol"]');
      if (pasek && ceny && 'IntersectionObserver' in window) {
        const stan = { ceny: true, dol: false };
        const odswiez = () => { pasek.hidden = stan.ceny || stan.dol || ceny.getBoundingClientRect().top > 0; };
        new IntersectionObserver((e) => { stan.ceny = e[0].isIntersecting; odswiez(); }, { threshold: 0 }).observe(ceny);
        if (dol) new IntersectionObserver((e) => { stan.dol = e[0].isIntersecting; odswiez(); }, { threshold: 0 }).observe(dol);
      }
    </script>
</article>
  <script is:inline>
    // Miniatury przewijają taśmę zdjęć w poziomie. Bez skryptu kotwice #kl-…
    // też działają – skrypt tylko zapobiega przeskokowi całej strony
    // i podświetla aktywną miniaturę.
    document.querySelectorAll('.miniatury').forEach((pasek) => {
      const tasma = document.getElementById(pasek.dataset.tasma);
      if (!tasma) return;
      const guziki = [...pasek.querySelectorAll('.miniatura-btn')];
      const oznacz = (i) => guziki.forEach((g, j) => g.classList.toggle('aktywna', i === j));
      oznacz(0);
      guziki.forEach((g, i) => {
        g.addEventListener('click', (e) => {
          e.preventDefault();
          tasma.scrollTo({ left: i * tasma.clientWidth, behavior: 'smooth' });
          oznacz(i);
        });
      });
      tasma.addEventListener('scroll', () => {
        oznacz(Math.round(tasma.scrollLeft / tasma.clientWidth));
      }, { passive: true });
    });
  </script>
</Base>
