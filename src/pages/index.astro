---
import Base from '../layouts/Base.astro';
import TabelaSetow from '../components/TabelaSetow.astro';
import sety from '../data/sety.json';
import wycofaniaDane from '../data/wycofania.json';
import ofertyFeed from '../data/oferty_feed.json';
import { urlZdjecia } from '../lib/media.js';
import { zajawkaArtykulu } from '../lib/artykuly.js';
import ZajawkaArtykulu from '../components/ZajawkaArtykulu.astro';
import { linkAfiliacyjny, fmtCena, nazwaSklepu } from '../lib/oferty.js';
import { wierszWycofania } from '../lib/wiersze.js';

const zaKlocek = (s) => (s.cena_katalogowa / s.elementy).toFixed(2).replace('.', ',');
const najlepszaCena = (s) => Math.min(...s.oferty.map((o) => o.cena));
const najtanszaOferta = (s) => s.oferty.reduce((a, o) => (a === null || o.cena < a.cena ? o : a), null);
const rabat = (s) => Math.round((1 - najlepszaCena(s) / s.cena_katalogowa) * 100);

// serie „kolekcjonerskie" na potrzeby doboru deala dnia i siatki 4×4 — ustalenie redakcyjne, nie publikujemy go na stronie
const KOLEKCJONERSKIE = new Set(['Ideas', 'Icons', 'Star Wars', 'Technic', 'Harry Potter', 'Botanicals']);

const wpisy = Object.entries(sety)
  .map(([nr, s]) => ({ nr, ...s, foto: urlZdjecia(nr, { sety }) }))
  .filter((s) => s.oferty?.length);

// ── Deale dnia (slajder, do 5 odsłon): po jednym z każdej półki cenowej + 2 dzikie karty ──
// Procentowo największe rabaty trafiają się na tanich setach, więc bez kwotowania
// drogie zestawy nigdy nie wchodziły do karuzeli — a 20% z 1000 zł to więcej niż 33% ze 120 zł.
// Sloty 1–3: najlepszy rabat z półek 801 zł+, 201–800 zł i do 200 zł (w tej kolejności).
// Sloty 4–5: kolejne najwyższe rabaty ogółem, maks. 2 sety z jednej serii.
const POLKI = [
  { klucz: 'premium', etykieta: '801 zł+', pasuje: (c) => c > 800 },
  { klucz: 'sredni', etykieta: '201–800 zł', pasuje: (c) => c > 200 && c <= 800 },
  { klucz: 'budzet', etykieta: 'do 200 zł', pasuje: (c) => c <= 200 },
];
const polkaSetu = (s) => POLKI.find((p) => p.pasuje(najlepszaCena(s)));
const zRabatem = wpisy.filter((s) => rabat(s) >= 15).sort((a, b) => rabat(b) - rabat(a));
const kandydaciSlajdera = zRabatem.filter((s) => s.foto);
const dealeDnia = [];
const naSerie = {};
const wez = (s) => {
  dealeDnia.push(s);
  naSerie[s.seria] = (naSerie[s.seria] ?? 0) + 1;
};
for (const polka of POLKI) {
  const top = kandydaciSlajdera.find((s) => polka.pasuje(najlepszaCena(s)) && !dealeDnia.includes(s));
  if (top) wez(top);
}
for (const s of kandydaciSlajdera) {
  if (dealeDnia.length >= 5) break;
  if (dealeDnia.includes(s) || (naSerie[s.seria] ?? 0) >= 2) continue;
  wez(s);
}
const dealDnia = dealeDnia[0] ?? null;

// ── „Dziś w dobrej cenie": do 12 setów kolekcjonerskich + po ≤10 z 12 losowych serii ──
// Losowanie serii z ziarnem z daty — skład stały w ciągu dnia, zmienia się między dniami
// (build odpala się przy każdym pushu danych, bez ziarna skład skakałby co deploy).
const ziarno = Number(new Date().toISOString().slice(0, 10).replaceAll('-', ''));
const los = (() => { let a = ziarno; return () => { a |= 0; a = (a + 0x6d2b79f5) | 0; let t = Math.imul(a ^ (a >>> 15), 1 | a); t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t; return ((t ^ (t >>> 14)) >>> 0) / 4294967296; }; })();

const wSlajderze = new Set(dealeDnia.map((s) => s.nr));
const pula = zRabatem.filter((s) => !wSlajderze.has(s.nr));
const kolekcjonerskie = pula.filter((s) => KOLEKCJONERSKIE.has(s.seria)).slice(0, 12);

const serieInne = [...new Set(pula.filter((s) => !KOLEKCJONERSKIE.has(s.seria)).map((s) => s.seria))]
  .map((seria) => ({ seria, klucz: los() }))
  .sort((a, b) => a.klucz - b.klucz)
  .slice(0, 12)
  .map((x) => x.seria);
const zSerii = serieInne.flatMap((seria) =>
  pula.filter((s) => s.seria === seria).sort((a, b) => rabat(b) - rabat(a)).slice(0, 10),
);

const dobreCeny = [...kolekcjonerskie, ...zSerii].sort((a, b) => rabat(b) - rabat(a));
// chipy: serie kolekcjonerskie najpierw, potem reszta alfabetycznie
const serieWSiatce = [...new Set(dobreCeny.map((s) => s.seria))]
  .sort((a, b) => (KOLEKCJONERSKIE.has(b) ? 1 : 0) - (KOLEKCJONERSKIE.has(a) ? 1 : 0) || a.localeCompare(b, 'pl'));

// ── Top 10 wycofań wartych upolowania ──
const feedSety = ofertyFeed?.sety ?? {};
const punkty = (w) => {
  const wiersz = wierszWycofania(w, { sety, feed: feedSety });
  let p = 0;
  if (w.status === 'potwierdzone') p += 3;
  if (wiersz.oferta) p += 3;
  if (wiersz.oferta && wiersz.cenaKatalogowa) {
    const r = Math.round((1 - wiersz.oferta.cena / wiersz.cenaKatalogowa) * 100);
    if (r >= 20) p += 2;
    else if (r >= 10) p += 1;
  }
  if (KOLEKCJONERSKIE.has(w.seria)) p += 2;
  if ((w.kiedy ?? '').includes('grudzień')) p += 1;
  if (w.kiedy === 'wycofany') p -= 4; // rynek wtórny — nie da się już „upolować" w sklepie
  return { wiersz, p };
};
const topWycofania = wycofaniaDane.wycofania
  .map(punkty)
  .sort((a, b) => b.p - a.p)
  .slice(0, 10)
  .map((x) => x.wiersz);
const liczbaWycofan = wycofaniaDane.wycofania.length;

// ── Zajawki artykułów: 6 najnowszych (dwa rzędy po trzy w siatce .zajawki) ──
const artykuly = Object.entries({
  ...import.meta.glob('./artykuly/*.md', { eager: true }),
  ...import.meta.glob('./prezentowniki/*.md', { eager: true }),
  ...import.meta.glob('./*.md', { eager: true }),
})
  .map(([, m]) => m)
  // ./*.md łapie każdy nowy plik .md w src/pages — kategoria jest testem,
  // czy to artykuł (patrz NARZEDZIA.md)
  .filter((m) => m.frontmatter?.kategoria)
  .sort((a, b) => new Date(b.frontmatter.data) - new Date(a.frontmatter.data))
  .slice(0, 6)
  .map((m) => zajawkaArtykulu(m));
---
<Base
  title="Promocje LEGO dziś — prawdziwe rabaty"
  description="Codziennie sprawdzamy ceny zestawów LEGO w największych sklepach. Rabaty liczymy od cen katalogowych, wyłapujemy najniższe ceny w historii."
  jsonld={{
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: 'tylkoklocki.pl',
    url: 'https://tylkoklocki.pl/',
    potentialAction: {
      '@type': 'SearchAction',
      target: { '@type': 'EntryPoint', urlTemplate: 'https://tylkoklocki.pl/wycofania/?q={search_term_string}' },
      'query-input': 'required name=search_term_string',
    },
  }}
>
  <h1 class="glowna-h1">Prawdziwe promocje na klocki LEGO — rabaty liczone od cen katalogowych</h1>

  {dealeDnia.length > 0 && (
    <section class="deale-slajder karta" aria-roledescription="karuzela" aria-label="Deale dnia">
      <div class="slajder-tor" data-slajder-tor tabindex="0">
        {dealeDnia.map((deal, i) => {
          const oferta = najtanszaOferta(deal);
          return (
            <article class="deal-dnia slajd" role="group" aria-roledescription="slajd" aria-label={`${i + 1} z ${dealeDnia.length}`}>
              <a class="foto-okno deal-foto" href={`/zestaw/${deal.nr}/`}>
                <img
                  src={deal.foto}
                  alt={`LEGO ${deal.nr} ${deal.nazwa}`}
                  width="800"
                  height="800"
                  loading={i === 0 ? 'eager' : 'lazy'}
                />
              </a>
              <div class="deal-tresc">
                <span class="eyebrow">
                  <span class="studs" aria-hidden="true"><i></i><i></i><i></i><i></i></span>
                  Deal dnia · {new Date().toLocaleDateString('pl-PL')}
                  {dealeDnia.length > 1 && <span class="slajd-licznik">{i + 1}/{dealeDnia.length}</span>}
                  {polkaSetu(deal) && <span class="slajd-polka">{polkaSetu(deal).etykieta}</span>}
                </span>
                <h2 class="deal-tytul">LEGO {deal.nr} {deal.nazwa}</h2>
                <div class="cena-duza">
                  {fmtCena(najlepszaCena(deal))}
                  <small>{fmtCena(deal.cena_katalogowa)}</small>
                </div>
                <div>
                  <span class="badge-rabat">−{rabat(deal)}% od ceny katalogowej</span>
                </div>
                <div class="deal-meta">
                  <span><strong>{deal.elementy}</strong> elementów</span>
                  <span><strong>{zaKlocek(deal)} zł</strong> za klocek</span>
                  <span>seria <strong>{deal.seria}</strong></span>
                  <span>wiek <strong>{deal.wiek}</strong></span>
                </div>
                <div class="deal-akcje">
                  {oferta && linkAfiliacyjny(oferta.sklep, deal.nr) && (
                    <a class="cta" href={linkAfiliacyjny(oferta.sklep, deal.nr)} rel="sponsored nofollow">
                      Sprawdź w {nazwaSklepu(oferta.sklep)} →
                    </a>
                  )}
                  <a class="deal-wiecej" href={`/zestaw/${deal.nr}/`}>Pełna karta zestawu i porównanie cen →</a>
                </div>
              </div>
            </article>
          );
        })}
      </div>
      {dealeDnia.length > 1 && (
        <>
          <button type="button" class="slajder-strzalka slajder-strzalka--wstecz" data-slajder="wstecz" aria-label="Poprzedni deal">‹</button>
          <button type="button" class="slajder-strzalka slajder-strzalka--dalej" data-slajder="dalej" aria-label="Następny deal">›</button>
          <div class="slajder-kropki" role="tablist" aria-label="Wybierz deal">
            {dealeDnia.map((deal, i) => (
              <button
                type="button"
                class={`slajder-kropka${i === 0 ? ' slajder-kropka--aktywna' : ''}`}
                data-kropka={i}
                aria-label={`Deal ${i + 1}: LEGO ${deal.nr} ${deal.nazwa}`}
              ></button>
            ))}
          </div>
        </>
      )}
    </section>
  )}

  <section class="sekcja" aria-label="Dzisiejsze dobre ceny">
    <div class="sekcja-head">
      <span class="studs studs--granat" aria-hidden="true"><i></i><i></i><i></i><i></i></span>
      <h2>Dziś w dobrej cenie</h2>
    </div>
    <p>Najlepsze dzisiejsze rabaty od cen katalogowych. Skład serii losujemy codziennie.</p>
    <div class="chipy" role="group" aria-label="Filtruj po serii">
      <button type="button" class="chip chip--aktywny" data-chip="">Wszystkie</button>
      {serieWSiatce.map((s) => (
        <button type="button" class="chip" data-chip={s}>{s}</button>
      ))}
    </div>
    <div class="siatka siatka--4x4">
      {dobreCeny.map((s) => (
        <a class="karta set-karta set-karta--mini" href={`/zestaw/${s.nr}/`} data-seria={s.seria}>
          {s.foto
            ? <img class="miniatura" src={s.foto} alt={`LEGO ${s.nr} ${s.nazwa}`} loading="lazy" width="300" height="225" />
            : <span class="foto-brak" aria-hidden="true"><span class="studs studs--granat"><i></i><i></i><i></i><i></i></span></span>}
          <span class="nr">LEGO {s.nr}</span>
          <h3>{s.nazwa}</h3>
          <div class="cena-linia">
            <span class="cena">{fmtCena(najlepszaCena(s))}</span>
            <span class="badge-rabat-mini">−{rabat(s)}%</span>
          </div>
        </a>
      ))}
    </div>
    <nav class="paginacja" aria-label="Kolejne strony dobrych cen" hidden>
      <button type="button" class="pg-przycisk" data-pg="wstecz">‹ Poprzednie</button>
      <span class="pg-licznik" aria-live="polite"></span>
      <button type="button" class="pg-przycisk" data-pg="dalej">Następne ›</button>
    </nav>
  </section>

  <section class="sekcja" aria-label="Najciekawsze wycofania">
    <div class="sekcja-head">
      <span class="studs studs--granat" aria-hidden="true"><i></i><i></i><i></i><i></i></span>
      <h2>Top 10 wycofań wartych upolowania</h2>
    </div>
    <p>Zestawy, które niedługo znikną z produkcji — kupione teraz bywają najtańsze w historii, a po wycofaniu drożeją. <a href="/wycofania/">Pełna lista {liczbaWycofan} wycofań →</a></p>
    <TabelaSetow wiersze={topWycofania} pokazKiedy />
  </section>

  {artykuly.length > 0 && (
    <section class="sekcja" aria-label="Najnowsze artykuły">
      <div class="sekcja-head">
        <span class="studs studs--granat" aria-hidden="true"><i></i><i></i><i></i><i></i></span>
        <h2>Ostatnio na blogu</h2>
      </div>
      <div class="zajawki">
        {artykuly.map((a) => <ZajawkaArtykulu zajawka={a} />)}
      </div>
    </section>
  )}

  <section class="sekcja persony">
    <div class="karta persona">
      <h3>👨‍👩‍👧 Kupujesz dla dziecka?</h3>
      <p>Przy każdym zestawie piszemy, dla jakiego wieku jest <em>naprawdę</em> — nie tylko to, co na pudełku. Bez przepłacania, bez niewypałów.</p>
    </div>
    <div class="karta persona afol">
      <h3>🧱 Budujesz kolekcję?</h3>
      <p>Cena za klocek, alerty wycofań (EOL) i historia najniższych cen. Mamy w domu ponad 1000 zestawów — wiemy, co i kiedy warto brać.</p>
    </div>
  </section>
</Base>

<script>
  // Slajder deali dnia — scroll-snap robi przewijanie (dotyk/trackpad działa bez JS),
  // skrypt dokłada strzałki, kropki i autoplay. Autoplay stoi przy ograniczeniu ruchu
  // (prefers-reduced-motion) i gaśnie na stałe po pierwszej interakcji użytkownika.
  const $slajder = document.querySelector('.deale-slajder');
  if ($slajder) {
    const tor = $slajder.querySelector('[data-slajder-tor]');
    const slajdy = [...tor.querySelectorAll('.slajd')];
    const kropki = [...$slajder.querySelectorAll('[data-kropka]')];
    let indeks = 0;
    let autoplay = null;

    const idz = (i, plynnie = true) => {
      indeks = (i + slajdy.length) % slajdy.length;
      tor.scrollTo({ left: indeks * tor.clientWidth, behavior: plynnie ? 'smooth' : 'auto' });
    };
    const zaznacz = () => {
      kropki.forEach((k, i) => k.classList.toggle('slajder-kropka--aktywna', i === indeks));
    };

    if (slajdy.length > 1) {
      $slajder.addEventListener('click', (e) => {
        const strzalka = e.target.closest('[data-slajder]');
        if (strzalka) idz(indeks + (strzalka.dataset.slajder === 'dalej' ? 1 : -1));
        const kropka = e.target.closest('[data-kropka]');
        if (kropka) idz(Number(kropka.dataset.kropka));
      });
      tor.addEventListener('scroll', () => {
        const i = Math.round(tor.scrollLeft / tor.clientWidth);
        if (i !== indeks) { indeks = i; zaznacz(); }
      }, { passive: true });
      tor.addEventListener('keydown', (e) => {
        if (e.key === 'ArrowRight') { e.preventDefault(); idz(indeks + 1); }
        if (e.key === 'ArrowLeft') { e.preventDefault(); idz(indeks - 1); }
      });

      const stopAutoplay = () => { clearInterval(autoplay); autoplay = null; };
      if (!matchMedia('(prefers-reduced-motion: reduce)').matches) {
        autoplay = setInterval(() => {
          if (document.hidden) return;
          idz(indeks + 1);
        }, 7000);
        ['pointerdown', 'keydown', 'wheel', 'touchstart'].forEach((zdarzenie) =>
          $slajder.addEventListener(zdarzenie, stopAutoplay, { once: true, passive: true }),
        );
      }
      zaznacz();
    }
  }

  // Filtr chipów + stronicowanie — czysto klienckie, wszystkie karty są w HTML (SEO).
  // Widok „Wszystkie" stronicuje po 12 (3 rzędy × 4); pojedyncza seria ma ≤12 kart,
  // więc mieści się bez stronicowania.
  const NA_STRONE = 12;
  const chipy = [...document.querySelectorAll('.chip')];
  const karty = [...document.querySelectorAll('.set-karta--mini')];
  const $pag = document.querySelector('.paginacja');
  const $licznik = document.querySelector('.pg-licznik');
  let seria = '';
  let strona = 0;

  function rysuj() {
    const widoczne = seria ? karty.filter((k) => k.dataset.seria === seria) : karty;
    const stron = Math.max(1, Math.ceil(widoczne.length / NA_STRONE));
    strona = Math.min(strona, stron - 1);
    const od = seria ? 0 : strona * NA_STRONE;
    const doIdx = seria ? widoczne.length : od + NA_STRONE;
    karty.forEach((k) => { k.hidden = true; });
    widoczne.slice(od, doIdx).forEach((k) => { k.hidden = false; });

    const pokazPag = !seria && stron > 1;
    $pag.hidden = !pokazPag;
    if (pokazPag) {
      $licznik.textContent = `${strona + 1} / ${stron}`;
      $pag.querySelector('[data-pg="wstecz"]').disabled = strona === 0;
      $pag.querySelector('[data-pg="dalej"]').disabled = strona === stron - 1;
    }
  }

  chipy.forEach((ch) => ch.addEventListener('click', () => {
    chipy.forEach((c) => c.classList.toggle('chip--aktywny', c === ch));
    seria = ch.dataset.chip;
    strona = 0;
    rysuj();
  }));
  $pag.addEventListener('click', (e) => {
    const b = e.target.closest('.pg-przycisk');
    if (!b || b.disabled) return;
    strona += b.dataset.pg === 'dalej' ? 1 : -1;
    rysuj();
    document.querySelector('.chipy').scrollIntoView({ block: 'nearest', behavior: 'smooth' });
  });
  rysuj();
</script>
