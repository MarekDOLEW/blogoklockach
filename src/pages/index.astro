---
import Base from '../layouts/Base.astro';
import TabelaSetow from '../components/TabelaSetow.astro';
import sety from '../data/sety.json';
import wycofaniaDane from '../data/wycofania.json';
import ofertyFeed from '../data/oferty_feed.json';
import cenyBaza from '../data/ceny_baza.json';
import { urlZdjecia, opisSetu, obrazStaly, obrazPlynny } from '../lib/media.js';
import { wpisKatalogu } from '../lib/katalog.js';
import { zajawkaArtykulu, zajawkaZMeta, sortujPostyDealowe, najnowszePierwsze } from '../lib/artykuly.js';
import ZajawkaArtykulu from '../components/ZajawkaArtykulu.astro';
import KartaAktualnosci from '../components/KartaAktualnosci.astro';
import { aktualnosci, jestAktualnoscia } from '../lib/aktualnosci.js';
import { linkAfiliacyjny, fmtCena, fmtElementy, odmien, nazwaSklepu, relLinku as relSklepu, filtrujOferty } from '../lib/oferty.js';
import { wierszWycofania } from '../lib/wiersze.js';
import { limitAllegro } from '../lib/deale.js';

const najlepszaCena = (s) => Math.min(...s.oferty.map((o) => o.cena));
const najtanszaOferta = (s) => s.oferty.reduce((a, o) => (a === null || o.cena < a.cena ? o : a), null);
const rabat = (s) => Math.round((1 - najlepszaCena(s) / s.cena_katalogowa) * 100);

// serie „kolekcjonerskie" na potrzeby doboru deala dnia i siatki 4×4 – ustalenie redakcyjne, nie publikujemy go na stronie
const KOLEKCJONERSKIE = new Set(['Ideas', 'Icons', 'Star Wars', 'Technic', 'Harry Potter', 'Botanicals']);

const wpisy = Object.entries(sety)
  .map(([nr, s]) => ({ nr, ...s, oferty: filtrujOferty(s.oferty, nr), foto: urlZdjecia(nr, { sety }) }))
  .filter((s) => s.oferty?.length);

// ── Deale dnia (slajder, do 5 odsłon): po jednym z każdej półki cenowej + 2 dzikie karty ──
// Procentowo największe rabaty trafiają się na tanich zestawach, więc bez kwotowania
// drogie zestawy nigdy nie wchodziły do karuzeli – a 20% z 1000 zł to więcej niż 33% ze 120 zł.
// Sloty 1–3: półki 801 zł+, 201–800 zł i do 200 zł. Sloty 4–5: dzikie karty, maks. 2 sety z serii.
//
// Dobór w obrębie półki NIE jest już „zawsze najwyższy rabat" – głębokie rabaty wiszą
// tygodniami i karuzela pokazywała codziennie to samo. Zamiast tego:
//   1. pierwszeństwo mają sety, które DZIŚ zaliczyły nowe minimum cenowe (prawdziwy news),
//   2. w przeciwnym razie los z ziarnem daty wybiera spośród czołówki półki
//      (rabat maks. 8 p.p. od lidera, do 5 kandydatów) – skład rotuje między dniami,
//      a jakość dealu pozostaje porównywalna.
const POLKI = [
  { klucz: 'premium', etykieta: '801 zł+', pasuje: (c) => c > 800 },
  { klucz: 'sredni', etykieta: '201–800 zł', pasuje: (c) => c > 200 && c <= 800 },
  { klucz: 'budzet', etykieta: 'do 200 zł', pasuje: (c) => c <= 200 },
];

// ziarno z daty – skład stały w ciągu dnia, inny każdego dnia (build odpala się przy każdym pushu)
const dzisiaj = new Date().toISOString().slice(0, 10);
const ziarno = Number(dzisiaj.replaceAll('-', ''));
const los = (() => { let a = ziarno; return () => { a |= 0; a = (a + 0x6d2b79f5) | 0; let t = Math.imul(a ^ (a >>> 15), 1 | a); t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t; return ((t ^ (t >>> 14)) >>> 0) / 4294967296; }; })();

// nowe minimum z ostatniego przebiegu Łowcy = najmocniejszy sygnał świeżości.
// Porównujemy z datą danych (najświeższa data ofert), nie z zegarem builda –
// build odpalony po północy UTC ma już „jutrzejszą" datę kalendarzową.
const dzienDanych = wpisy
  .flatMap((s) => s.oferty.map((o) => o.data ?? ''))
  .reduce((a, b) => (b > a ? b : a), '');
const noweMinimumDzis = (s) =>
  cenyBaza[s.nr]?.najnizsza_data === dzienDanych && cenyBaza[s.nr]?.najnizsza_cena === najlepszaCena(s);

const zRabatem = wpisy.filter((s) => rabat(s) >= 15).sort((a, b) => rabat(b) - rabat(a));
const kandydaciSlajdera = zRabatem.filter((s) => s.foto);

// Allegro nie może zdominować karuzeli: linki do Allegro to maks. 30% linków
// w dealach (ustalenie Marka z 13.09.2026, zaostrzenie limitu „2 z 5" z 05.09) –
// przy 5 slajdach zostaje 1 slot. Marketplace wygrywa ceną niemal każdy slot,
// a karuzela jest wizytówką serwisu i ma pokazywać też sklepy z własnym magazynem.
// Po wyczerpaniu limitu slot dostaje najlepszą ofertę SPOZA Allegro – pokazywaną
// z ceną i rabatem tego sklepu (nadal ≥15%, żeby nie promować pseudopromocji);
// set bez takiej oferty odpada z dalszych slotów. Reguła i próg: src/lib/deale.js.
const SLOTY_SLAJDERA = 5;
const LIMIT_ALLEGRO = limitAllegro(SLOTY_SLAJDERA);
let uzyteAllegro = 0;
const rabatOferty = (s, o) => Math.round((1 - o.cena / s.cena_katalogowa) * 100);
const najtanszaSpozaAllegro = (s) =>
  s.oferty.filter((o) => o.sklep !== 'allegro').reduce((a, o) => (a === null || o.cena < a.cena ? o : a), null);
const paraDealu = (s) => {
  const naj = najtanszaOferta(s);
  if (naj.sklep !== 'allegro' || uzyteAllegro < LIMIT_ALLEGRO) return { set: s, oferta: naj };
  const alt = najtanszaSpozaAllegro(s);
  return alt && rabatOferty(s, alt) >= 15 ? { set: s, oferta: alt } : null;
};

const dealeDnia = []; // pary { set, oferta }
const naSerie = {};
const wez = (para) => {
  if (!para) return;
  dealeDnia.push(para);
  naSerie[para.set.seria] = (naSerie[para.set.seria] ?? 0) + 1;
  if (para.oferta.sklep === 'allegro') uzyteAllegro += 1;
};
const losowyZ = (lista) => lista[Math.floor(los() * lista.length)] ?? null;
const juzWSlajderze = (s) => dealeDnia.some((d) => d.set === s);
for (const polka of POLKI) {
  const wPolce = kandydaciSlajdera
    .filter((s) => !juzWSlajderze(s))
    .map(paraDealu)
    .filter((p) => p && polka.pasuje(p.oferta.cena));
  if (!wPolce.length) continue;
  const swieze = wPolce.filter((p) => noweMinimumDzis(p.set) && p.oferta.cena === najlepszaCena(p.set));
  const czolowka = wPolce
    .filter((p) => rabatOferty(p.set, p.oferta) >= rabatOferty(wPolce[0].set, wPolce[0].oferta) - 8)
    .slice(0, 5);
  wez(losowyZ(swieze.length ? swieze.slice(0, 5) : czolowka));
}
// dzikie karty: seedowane losowanie z 10 najwyższych pozostałych rabatów
const rezerwa = kandydaciSlajdera.filter((s) => !juzWSlajderze(s)).slice(0, 10);
while (dealeDnia.length < SLOTY_SLAJDERA && rezerwa.length) {
  const kandydaci = rezerwa.map(paraDealu).filter((p) => p && (naSerie[p.set.seria] ?? 0) < 2);
  if (!kandydaci.length) break;
  const p = losowyZ(kandydaci);
  rezerwa.splice(rezerwa.indexOf(p.set), 1);
  wez(p);
}

// ── „Dziś w dobrej cenie": 6 obowiązkowych kategorii + po ≤10 z 12 losowych serii ──
// (korzysta z tego samego seedowanego `los` co slajder – zdefiniowany wyżej)
// Obowiązkowa szóstka z minimum 5 zestawów każda (decyzja Marka 27.09.2026).
// Kwalifikacja od progu serii: Ideas i Icons 20% (krótsze katalogi rzadko
// schodzą 30% pod cenę – 27.09 Ideas miało 3 sety ≥30%, a 9 setów ≥20%),
// pozostałe 30%. Gdy seria nie wystawia 5 zestawów z progiem, dobieramy do
// pięciu z jej ofert ≥15% (pula bloku) – to wciąż realny rabat, nie
// pseudopromocja; poniżej 15% wolimy pokazać mniej niż 5.
const OBOWIAZKOWE = new Map([
  ['City', 30], ['Star Wars', 30], ['Technic', 30], ['Harry Potter', 30],
  ['Icons', 20], ['Ideas', 20],
]);
const MIN_NA_KATEGORIE = 5;
const wSlajderze = new Set(dealeDnia.map((d) => d.set.nr));
const pula = zRabatem.filter((s) => !wSlajderze.has(s.nr));
const obowiazkowe = [...OBOWIAZKOWE].flatMap(([seria, prog]) => {
  const wSerii = pula.filter((s) => s.seria === seria).sort((a, b) => rabat(b) - rabat(a));
  const zProgiem = wSerii.filter((s) => rabat(s) >= prog).slice(0, 10);
  const brakuje = MIN_NA_KATEGORIE - zProgiem.length;
  return brakuje > 0 ? [...zProgiem, ...wSerii.filter((s) => rabat(s) < prog).slice(0, brakuje)] : zProgiem;
});

const serieInne = [...new Set(pula.filter((s) => !OBOWIAZKOWE.has(s.seria)).map((s) => s.seria))]
  .map((seria) => ({ seria, klucz: los() }))
  .sort((a, b) => a.klucz - b.klucz)
  .slice(0, 12)
  .map((x) => x.seria);
const zSerii = serieInne.flatMap((seria) =>
  pula.filter((s) => s.seria === seria).sort((a, b) => rabat(b) - rabat(a)).slice(0, 10),
);

const dobreCeny = [...obowiazkowe, ...zSerii].sort((a, b) => rabat(b) - rabat(a));
// chipy: obowiązkowa szóstka najpierw, potem reszta alfabetycznie
const serieWSiatce = [...new Set(dobreCeny.map((s) => s.seria))]
  .sort((a, b) => (OBOWIAZKOWE.has(b) ? 1 : 0) - (OBOWIAZKOWE.has(a) ? 1 : 0) || a.localeCompare(b, 'pl'));

// ── Top 10 wycofań wartych upolowania ──
const feedSety = ofertyFeed?.sety ?? {};
const punkty = (w) => {
  const wiersz = wierszWycofania(w, { sety, feed: feedSety });
  let p = 0;
  if (w.status === 'potwierdzone') p += 3;
  if (wiersz.oferta) p += 3;
  if (wiersz.oferta && wiersz.cenaKatalogowa) {
    const r = Math.round((1 - wiersz.oferta.cena / wiersz.cenaKatalogowa) * 100);
    if (r >= 20) p += 2;
    else if (r >= 10) p += 1;
  }
  if (KOLEKCJONERSKIE.has(w.seria)) p += 2;
  if ((w.kiedy ?? '').includes('grudzień')) p += 1;
  if (w.kiedy === 'wycofany') p -= 4; // rynek wtórny – nie da się już „upolować" w sklepie
  return { wiersz, p };
};
// wpisy „odwołane" (LEGO przedłużyło sprzedaż) zostają w pliku, ale nie na liście
const topWycofania = wycofaniaDane.wycofania
  .filter((w) => w.kiedy !== 'odwołane')
  .map(punkty)
  .sort((a, b) => b.p - a.p)
  .slice(0, 10)
  .map((x) => x.wiersz);
const liczbaWycofan = wycofaniaDane.wycofania.filter((w) => w.kiedy !== 'odwołane').length;

// ── Zajawki artykułów: 6 najnowszych (dwa rzędy po trzy w siatce .zajawki) ──
// Prezentowniki mają na tej stronie własny rząd wyżej, więc tutaj ich nie ma –
// inaczej ten sam przewodnik potrafiłby wyjść dwa razy na jednym ekranie.
const artykuly = Object.entries({
  ...import.meta.glob('./artykuly/*.md', { eager: true }),
  ...import.meta.glob('./prezentowniki/*.md', { eager: true }),
  ...import.meta.glob('./*.md', { eager: true }),
})
  .map(([, m]) => m)
  // ./*.md łapie każdy nowy plik .md w src/pages – kategoria jest testem,
  // czy to artykuł (patrz NARZEDZIA.md)
  .filter((m) => m.frontmatter?.kategoria && m.frontmatter.kategoria !== 'Prezentownik')
  // aktualności mają własny rząd pod slajderem – tu by się powtórzyły
  .filter((m) => !jestAktualnoscia(m))
  .sort(najnowszePierwsze)
  .slice(0, 6)
  .map((m) => zajawkaArtykulu(m));

// ── Aktualności pod slajderem (Marek 27.09.2026): akcje sklepów i kampanie
// z datą – ważniejsze niż zwykłe teksty, więc dwie karty w rzędzie zamiast
// trzech. Slajder do 6 pozycji, reszta pod „Zobacz wszystkie" (/aktualnosci/).
// ── 3 zestawy „Dziś w dobrej cenie" (Marek 27.09): losowo, nie same największe rabaty
// i nie same tanie – po jednym z przedziałów >500 zł, 151–500 zł, do 150 zł (los z ziarnem
// daty: stały w ciągu dnia, inny każdego dnia). Brak w przedziale → los z całej puli.
const PRZEDZIALY_TRZECH = [(c) => c > 500, (c) => c > 150 && c <= 500, (c) => c <= 150];
const trzyDobre = [];
for (const pasuje of PRZEDZIALY_TRZECH) {
  const pula3 = dobreCeny.filter((s) => pasuje(najlepszaCena(s)) && !trzyDobre.includes(s));
  const z = pula3.length ? pula3 : dobreCeny.filter((s) => !trzyDobre.includes(s));
  if (z.length) trzyDobre.push(z[Math.floor(los() * z.length)]);
}

// ── WERSJA 2 (Marek 27.09): „Dziś w dobrej cenie" jako listing jak na Promocjach –
// po 3 zestawy z każdego przedziału cenowego (>1500, 801–1500, 201–800, do 200 zł),
// losowo (ziarno daty) i przemieszane. Pula: rabat ≥15%; gdy w przedziale za mało,
// dobieramy z rabatem >0 (powyżej 1500 zł rabatów ≥15% bywa ledwie kilka).
const PRZEDZIALY_V2 = [(c) => c > 1500, (c) => c > 800 && c <= 1500, (c) => c > 200 && c <= 800, (c) => c <= 200];
const wLosowej = (lista) => lista.map((x) => ({ x, k: los() })).sort((a, b) => a.k - b.k).map((o) => o.x);
const listingDobre = wLosowej(PRZEDZIALY_V2.flatMap((pasuje) => {
  const wPrzedziale = wpisy.filter((s) => s.cena_katalogowa && pasuje(najlepszaCena(s)));
  const mocne = wLosowej(wPrzedziale.filter((s) => rabat(s) >= 15));
  const slabsze = wPrzedziale.filter((s) => rabat(s) > 0 && rabat(s) < 15).sort((a, b) => rabat(b) - rabat(a));
  return [...mocne, ...slabsze].slice(0, 3);
}));
const krotkiOpis = (nr) => {
  const tx = (opisSetu(nr, { sety })?.tekst ?? '').replace(/\s+/g, ' ').trim();
  if (!tx) return null;
  const zdania = tx.match(/[^.!?]+[.!?]+/g) ?? [tx];
  let w = zdania[0].trim();
  if (w.length < 70 && zdania[1]) w += ' ' + zdania[1].trim();
  return w.length > 180 ? w.slice(0, 170).replace(/\s+\S*$/, '') + '…' : w;
};
const ekskluzywny = (s) => Boolean(s.ekskluzyw || wpisKatalogu(s.nr)?.ekskluzyw);

const MAKS_AKTUALNOSCI = 6;

// ── Wejścia do działów (podgląd 27.09.2026): Nowości / Wycofania / Artykuły z licznikami ──
// ta sama reguła co /nowosci/: premiery od dwóch miesięcy wstecz + zapowiedzi
const teraz = new Date();
const odKiedyNowosci = `${new Date(teraz.getFullYear(), teraz.getMonth() - 2, 1).getFullYear()}-${String(new Date(teraz.getFullYear(), teraz.getMonth() - 2, 1).getMonth() + 1).padStart(2, '0')}`;
const liczbaNowosci = Object.values(sety).filter((s) => String(s?.premiera ?? '') >= odKiedyNowosci).length;
const liczbaArtykulow = Object.values({
  ...import.meta.glob('./artykuly/*.md', { eager: true }),
  ...import.meta.glob('./*.md', { eager: true }),
}).filter((m) => m.frontmatter?.kategoria && m.frontmatter.kategoria !== 'Prezentownik').length;
const aktualnosciGlowna = aktualnosci().slice(0, MAKS_AKTUALNOSCI);

// ── Trzy najnowsze posty dealowe (od 27.09.2026 pod „Dziś w dobrej cenie",
// wcześniej zaraz pod slajderem – to miejsce zajęły aktualności) (Marek 23.09.2026: dział /deale/
// był „zbyt ukryty" – wejście z listingu w stopce nikt nie klikał). Źródło to
// samo co listing /deale/: markdown z src/pages/deale/, najnowsze na górze.
// Kolejność: najpierw posty z `wyroznienie: true` we frontmatterze (kampania
// sklepu z datą końca – Marek 23.09: „x-kom ma być pierwszy w trójce"), potem
// data malejąco. Ta sama reguła w listingu /deale/ (src/lib/artykuly.js).
const postyDealowe = sortujPostyDealowe(Object.values(import.meta.glob('./deale/*.md', { eager: true })).filter((m) => !jestAktualnoscia(m)))
  .slice(0, 3)
  .map((m) => zajawkaArtykulu(m));

// ── Jeden rząd prezentowników: trzy wejścia do działu, po jednym z każdej
// strony, z której ludzie szukają prezentu – wiek, seria, budżet. Wybór jest
// redakcyjny, więc adresy stoją tu wprost; treść karty (tytuł, opis, zdjęcie,
// znacznik) czytamy z tych samych źródeł co listing /prezentowniki/, żeby
// zmiana w samym prezentowniku przechodziła tu sama i karty się nie rozjechały.
// Sezon XI–XII 2026 (od 24.09): trzy prezentowniki sezonowe – Mikołajki, dzieci
// w trzech kopertach, dorośli. Po świętach wrócić do osi wiek / seria / budżet.
const WYBRANE_PREZENTOWNIKI = [
  '/prezentowniki/na-mikolaja/',
  '/prezentowniki/swieta-dla-dzieci/',
  '/prezentowniki/swieta-dla-doroslych/',
];
const kartyPrezentownikow = new Map(
  [
    ...Object.values(import.meta.glob('./prezentowniki/*.md', { eager: true }))
      .filter((m) => m.frontmatter?.kategoria === 'Prezentownik')
      .map((m) => zajawkaArtykulu(m, { karty: true })),
    // prezentowniki serii to strony .astro – zamiast frontmattera mają `meta`
    ...Object.values(import.meta.glob('./prezentowniki/*.astro', { eager: true }))
      .map((m) => m.meta)
      .filter(Boolean)
      .map((m) => zajawkaZMeta(m, { karty: true })),
  ].map((z) => [z.url, z]),
);
const prezentowniki = WYBRANE_PREZENTOWNIKI.map((u) => kartyPrezentownikow.get(u)).filter(Boolean);

---
<Base
  preloadObrazu={dealeDnia[0]?.foto ? obrazPlynny(dealeDnia[0].foto, [440, 880], '(max-width: 600px) 60vw, 400px') : null}
  title="Promocje LEGO dziś – prawdziwe rabaty"
  description="Ceny zestawów LEGO w polskich sklepach z rabatem liczonym od ceny katalogowej. Nowe minima z naszych notowań, wycofania, nowości i recenzje."
  jsonld={{
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: 'tylkoklocki.pl',
    url: 'https://tylkoklocki.pl/',
    potentialAction: {
      '@type': 'SearchAction',
      target: { '@type': 'EntryPoint', urlTemplate: 'https://tylkoklocki.pl/szukaj/?q={search_term_string}' },
      'query-input': 'required name=search_term_string',
    },
  }}
>
  <div class="podglad-widok">
  <h1 class="glowna-h1">Prawdziwe promocje na klocki LEGO – rabaty liczone od cen katalogowych</h1>

  {dealeDnia.length > 0 && (
    <section class="deale-slajder karta" aria-roledescription="karuzela" aria-label="Deale dnia">
      <div class="slajder-tor" data-slajder-tor tabindex="0">
        {dealeDnia.map(({ set: deal, oferta }, i) => {
          return (
            <article class="deal-dnia slajd" role="group" aria-roledescription="slajd" aria-label={`${i + 1} z ${dealeDnia.length}`}>
              <a class="foto-okno deal-foto" href={`/zestaw/${deal.nr}/`} target="_blank" rel="noopener">
                <img
                  {...obrazPlynny(deal.foto, [440, 880], '(max-width: 600px) 60vw, 400px')}
                  alt={`LEGO ${deal.nr} ${deal.nazwa}`}
                  width="800"
                  height="800"
                  loading={i === 0 ? 'eager' : 'lazy'}
                  fetchpriority={i === 0 ? 'high' : undefined}
                />
              </a>
              {dealeDnia.length > 1 && <span class="slajd-licznik">{i + 1}/{dealeDnia.length}</span>}
              {POLKI.find((p) => p.pasuje(oferta.cena)) && (
                <span class="slajd-polka">{POLKI.find((p) => p.pasuje(oferta.cena)).etykieta}</span>
              )}
              <div class="deal-tresc">
                <h2 class="deal-tytul">LEGO {deal.nr} {deal.nazwa}</h2>
                <div class="deal-kategoria">
                  <span><span class="deal-etyk">seria </span><strong>{deal.seria}</strong></span>
                  <span>wiek <strong>{deal.wiek}</strong></span>
                  <span><strong>{fmtElementy(deal.elementy)}</strong> {odmien(deal.elementy, 'element', 'elementy', 'elementów')}</span>
                </div>
                <div class="cena-duza">
                  {fmtCena(oferta.cena)}
                  <small>{fmtCena(deal.cena_katalogowa)}</small>
                </div>
                <div class="deal-badges">
                  <span class="badge-rabat">−{rabatOferty(deal, oferta)}% od ceny katalogowej</span>
                  {noweMinimumDzis(deal) && oferta.cena === najlepszaCena(deal) && (
                    <span class="badge-najnizsza">nowe minimum cenowe</span>
                  )}
                </div>
                <div class="deal-akcje">
