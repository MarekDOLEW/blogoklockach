                    {aff
                      ? <a class="cta" href={aff} target="_blank" rel={relSklepu(oferta.sklep, s.nr)}>Sprawdź w {nazwaSklepu(oferta.sklep)}</a>
                      : <a class="cta" href={`/zestaw/${s.nr}/`} target="_blank" rel="noopener">Porównaj ceny</a>}
                  </td>
                </tr>
              );
            })}
          </tbody>
        </table>
      </div>
      <p class="sekcja-stopka">
        <a class="przycisk przycisk--duzy" href="/promocje-lego/">Zobacz wszystkie promocje LEGO →</a>
      </p>
