        <span class="wejscie__ile">{liczbaWycofan}</span>
        <span class="wejscie__etykieta">Wycofania</span>
        <span class="wejscie__opis">Zestawy, które LEGO wkrótce zdejmuje z produkcji – z terminem, statusem i dzisiejszą ceną.</span>
        <span class="wejscie__cta">Zobacz wycofania →</span>
      </a>
      <a class="karta wejscie" href="/artykuly/">
        <span class="wejscie__ile">{liczbaArtykulow}</span>
