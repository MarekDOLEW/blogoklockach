---
import Base from '../layouts/Base.astro';
import FiltrSetow from '../components/FiltrSetow.astro';
import TabelaSetow from '../components/TabelaSetow.astro';
import dane from '../data/wycofania.json';
import sety from '../data/sety.json';
import ofertyFeed from '../data/oferty_feed.json';
import { wierszWycofania } from '../lib/wiersze.js';

const kolejnosc = dane._meta.serie_kolejnosc;
// „odwołane" (LEGO przedłużyło sprzedaż) zostają w pliku dla historii, ale nie na liście
const wpisy = dane.wycofania.filter((w) => w.kiedy !== 'odwołane');
// Jedna lista, status przy każdym zestawie (ustalenie 14.09.2026). Wcześniej
// wycofania potwierdzone i prognozy stały w dwóch osobnych blokach – prognozy
// lądowały wtedy pod kilkuset wierszami i nikt do nich nie docierał. Teraz
// rozróżnienie niesie kolumna „Status" w każdym wierszu: „potwierdzone przez
// LEGO" (fakt: dział „Ostatnie sztuki", komunikat producenta albo zniknięcie
// z lego.com) albo „prognoza rynku" (zgodne zapowiedzi branżowe, jeszcze bez
// potwierdzenia). Etykiety pochodzą z lib/status.js, więc listing, hub i ta
// strona zawsze mówią to samo.
// Serie spoza _meta.serie_kolejnosc też muszą trafić na listę. 14.09.2026
// szesnaście zestawów z ręcznej weryfikacji Marka (Pokémon, Super Mario, DUPLO,
// Speed Champions…) zniknęło ze strony, bo ich serii nie było w tej liście —
// liczniki u góry je liczyły, sekcji poniżej nie było. Kolejność: najpierw
// lista z pliku, potem pozostałe serie alfabetycznie.
const pozaLista = [...new Set(wpisy.map((w) => w.seria))]
  .filter((s) => s && !kolejnosc.includes(s))
  .sort((a, b) => a.localeCompare(b, 'pl'));
const serie = [...kolejnosc.filter((s) => wpisy.some((w) => w.seria === s)), ...pozaLista];
const wSerii = (s) => wpisy.filter((w) => w.seria === s);
const potwierdzone = wpisy.filter((w) => w.status === 'potwierdzone').length;
const razem = wpisy.length;
const grudniowe = wpisy.filter((w) => w.kiedy === 'grudzień 2026').length;
const juzWycofane = wpisy.filter((w) => w.kiedy === 'wycofany').length;
const slug = (s) => s.toLowerCase().replace(/\s+/g, '-');

const feedSety = ofertyFeed?.sety ?? {};

// Wiersze do wspólnej tabeli – ten sam kształt co w katalogu serii i na stronie głównej.
const wiersz = (w) => wierszWycofania(w, { sety, feed: feedSety });

// Kolejność w serii idzie po tym, co czytelnik widzi w kolumnie Status, a nie po
// surowym polu z pliku: zestaw po EOL w LEGO, który został w innych sklepach, ma
// w danych status „potwierdzone", ale na liście jest „w sprzedaży" – sortowanie po
// surowym polu wrzucało go między zestawy z terminem i układ wyglądał przypadkowo.
// Od góry: pewny termin → termin z prognozy → już po EOL, ale jeszcze do kupienia →
// nie do kupienia. Przy równym statusie zostaje kolejność z pliku danych.
const KOLEJNOSC_STATUSU = { potwierdzone: 0, przewidywane: 1, sprzedaz: 2, eol: 3 };
const wierszeSerii = (seria) =>
  wSerii(seria)
    .map(wiersz)
    .sort((a, b) => (KOLEJNOSC_STATUSU[a.status] ?? 9) - (KOLEJNOSC_STATUSU[b.status] ?? 9));

// data aktualizacji w formacie polskim (z _meta, jedno źródło prawdy)
const MIESIACE = ['stycznia','lutego','marca','kwietnia','maja','czerwca','lipca','sierpnia','września','października','listopada','grudnia'];
const [rA, mA, dA] = dane._meta.aktualizacja.split('-').map(Number);
const aktualizacjaPL = `${dA} ${MIESIACE[mA - 1]} ${rA}`;

// FAQ – jedno źródło dla sekcji HTML i danych strukturalnych FAQPage
const faq = [
  {
    q: 'Kiedy LEGO wycofuje zestawy z produkcji?',
    a: `LEGO kończy sprzedaż zestawów w dwóch głównych falach: w połowie roku (przełom lipca i sierpnia) oraz na koniec grudnia. Największa jest fala grudniowa – w 2026 roku obejmuje ${grudniowe} zestawów z naszej listy. Daty potrafią się jednak przesuwać: LEGO czasem przedłuża życie popularnych setów albo wycofuje je przed terminem, gdy zapasy się wyczerpią.`,
  },
  {
    q: 'Czy wycofane zestawy LEGO drożeją?',
    a: 'Bardzo często tak, choć nie wszystkie w równym stopniu. Historycznie najmocniej zyskują zestawy licencyjne (Star Wars UCS, Ideas, ekskluzywy 18+), sety z unikalnymi minifigurkami oraz duże modele ekspozycyjne. Zwykłe zestawy City czy Friends drożeją wolniej albo wcale – kupuje się je przed EOL głównie po to, by nie przepłacać, a nie w celach inwestycyjnych.',
  },
  {
    q: 'Kiedy najlepiej kupić wycofywany zestaw LEGO?',
    a: 'Najkorzystniejszy moment to zwykle ostatnie tygodnie przed zniknięciem zestawu ze sklepów – sklepy wyprzedają wtedy zapasy i pojawiają się najniższe ceny w historii. Czekanie do samego końca bywa jednak ryzykowne: popularne sety potrafią wyprzedać się na długo przed oficjalną datą wycofania.',
  },
  {
    q: 'Co oznacza status „potwierdzone przez LEGO" i „prognoza rynku" na tej liście?',
    a: `„Potwierdzone przez LEGO" to fakt – oficjalny sygnał od Grupy LEGO: zestaw trafił do działu „Ostatnie sztuki" na lego.com, LEGO ogłosiło termin albo zestaw już zniknął z oficjalnego sklepu. „Prognoza rynku" to zgodne przewidywania źródeł branżowych (m.in. Brickset, Brick Fanatics, StoneWars), które zwykle się sprawdzają, ale LEGO może je jeszcze zmienić – gdy potwierdzi termin, zestaw zmienia status na potwierdzony. Obecnie lista zawiera ${potwierdzone} pozycji potwierdzonych przez LEGO i ${razem - potwierdzone} prognoz rynku.`,
  },
  {
    q: 'Które zestawy LEGO znikną w grudniu 2026?',
    a: `Fala grudniowa 2026 to ${grudniowe} zestawów – m.in. kolekcjonerski Sokół Millennium 75192 po dziewięciu latach sprzedaży, Muzeum Historii Naturalnej 10326, rezydencja X-Men 76294 i duża część aktualnej oferty City, Friends oraz Ninjago. Pełny podział znajdziesz na tej stronie po przefiltrowaniu wybranej serii.`,
  },
  {
    q: 'Co to jest EOL w LEGO?',
    a: 'EOL to skrót od „end of life" – moment, w którym LEGO na stałe kończy produkcję i sprzedaż zestawu. Po EOL set nie wraca już do regularnej oferty (wznowienia zdarzają się wyjątkowo rzadko). Inne sklepy sprzedają jednak zapasy jeszcze przez wiele miesięcy – dlatego zestaw ze znacznikiem EOL widzisz u nas nadal „w sprzedaży" z ceną sklepu, a dopiero gdy zniknie ze wszystkich śledzonych sklepów, zostaje rynek wtórny.',
  },
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faq.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};

const stronaSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  name: 'Wycofywane zestawy LEGO 2026 – pełna lista końcówek serii',
  inLanguage: 'pl-PL',
  dateModified: dane._meta.aktualizacja,
  description: `Lista ${razem} zestawów LEGO wycofywanych w 2026 roku, z podziałem na serie i statusem potwierdzenia.`,
};
---
<Base
  title="Wycofania LEGO 2026 – pełna lista (EOL)"
  description={`Które zestawy LEGO znikają w 2026? Pełna lista ${razem} wycofań: Star Wars, Icons, Ideas, Technic, Harry Potter i inne. ${potwierdzone} pozycji potwierdzonych przez LEGO. Aktualizacja: ${aktualizacjaPL}.`}
>
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(stronaSchema)} />
  <article>
    <h1 style="margin-top:28px">Wycofywane zestawy LEGO 2026 – pełna lista końcówek serii</h1>
    <p class="eol-aktualizacja">Ostatnia aktualizacja: <time datetime={dane._meta.aktualizacja}>{aktualizacjaPL}</time> · {razem} zestawów · {potwierdzone} potwierdzonych przez LEGO · {razem - potwierdzone} prognoz rynku · {juzWycofane} już wycofanych</p>
    <p class="prose prose--szeroki">Gdy LEGO wycofuje zestaw z produkcji, jego cena najpierw bywa najniższa w historii – a po zniknięciu z półek zaczyna rosnąć na rynku wtórnym. Zebraliśmy w jednym miejscu <strong>wszystkie {razem} zestawów, które znikają ze sprzedaży w 2026 roku</strong>, w 11 seriach: od Star Wars i Icons po City i Friends. Użyj filtra poniżej, by zawęzić listę do swojej serii, albo wpisz numer lub nazwę zestawu w wyszukiwarkę. Przy każdym zestawie, w kolumnie <strong>Status</strong>, stoi źródło terminu: <span class="badge-status badge-status--pewny">potwierdzone przez LEGO</span> to fakt – oficjalna informacja Grupy LEGO (dział „Ostatnie sztuki", komunikat albo zniknięcie z lego.com); <span class="badge-status badge-status--prognoza">prognoza rynku</span> to zgodne przewidywania źródeł branżowych, jeszcze niepotwierdzone. W każdej serii potwierdzone terminy stoją na górze. Znacznik <span class="tag-eol">EOL</span> oznacza, że LEGO już nie sprzedaje zestawu – często kupisz go jeszcze w innych sklepach, wtedy pokazujemy ich cenę. Wracaj tu regularnie – listę aktualizujemy na bieżąco.</p>
    <p class="disclosure">Ceny i przyciski „Sprawdź cenę" prowadzą przez linki afiliacyjne – kupując przez nie, wspierasz serwis, nie płacąc więcej. Ceny pobieramy z cenników sklepów; trwające promocje i kody rabatowe bywają w nich niewidoczne, więc cena w sklepie może się różnić od podanej – zwykle na Twoją korzyść. Sklepy zmieniają ceny także w ciągu dnia, więc kwota na stronie zestawu jest ostatnią, jaką zobaczyliśmy, a nie gwarancją – wiążąca jest zawsze cena w koszyku sklepu.</p>

    <FiltrSetow serie={serie} liczbaWSerii={(s) => wSerii(s).length} rzeczownik="zestawów" />

    {serie.map((seria) => (
      <section class="sekcja" id={`seria-${slug(seria)}`} data-grupa={seria} style="margin: 30px 0;">
        <div class="sekcja-head">
          <span class="studs studs--granat" aria-hidden="true"><i></i><i></i><i></i><i></i></span>
          <h2>{seria} <small class="sekcja-licznik">{wSerii(seria).length}</small></h2>
        </div>
        <TabelaSetow wiersze={wierszeSerii(seria)} />
        <p class="lista-pusta" data-pusto hidden>Brak wyników w tej serii dla obecnego filtra.</p>
      </section>
    ))}

    <section class="sekcja karta" style="padding:18px 22px;">
      <h2>Jak czytać tę listę?</h2>
      <p class="prose prose--szeroki" style="margin:0">Dla <strong>rodzica</strong>: jeśli zestaw z listy jest na liście życzeń dziecka – kup przed zniknięciem, po EOL ceny rosną zamiast spadać. Dla <strong>kolekcjonera</strong>: fala przecen tuż przed wycofaniem to często ostatni moment na najniższą cenę w historii; sety licencyjne (Ideas, ekskluzywy) historycznie zyskują najwięcej. Daty podajemy za LEGO – firma potrafi je zmieniać, więc wracaj tu regularnie.</p>
    </section>

    <section class="sekcja eol-faq" id="faq" style="margin: 34px 0;">
      <div class="sekcja-head">
        <span class="studs studs--granat" aria-hidden="true"><i></i><i></i><i></i><i></i></span>
        <h2>Wycofania LEGO – najczęstsze pytania</h2>
      </div>
      {faq.map((f) => (
        <div class="karta eol-faq-wpis">
          <h3>{f.q}</h3>
          <p class="prose prose--szeroki">{f.a}</p>
        </div>
      ))}
    </section>
  </article>
</Base>

<style is:global>
  .eol-aktualizacja { font-size: 0.85rem; opacity: 0.7; margin: 4px 0 14px; }
  .sekcja-licznik { font-weight: 600; color: var(--granat-60); font-size: 0.8em; margin-left: 4px; }
  .eol-faq-wpis { padding: 14px 18px; margin: 12px 0; }
  .eol-faq-wpis h3 { margin: 0 0 6px; font-size: 1.05rem; }
  .eol-faq-wpis p { margin: 0; }
</style>
