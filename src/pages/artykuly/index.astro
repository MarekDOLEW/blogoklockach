---
import Base from '../../layouts/Base.astro';
import ZajawkaArtykulu from '../../components/ZajawkaArtykulu.astro';
import { zajawkiArtykulow, zajawkaZMeta } from '../../lib/artykuly.js';
// Wszystkie artykuły serwisu, niezależnie od katalogu: recenzje i deale
// leżą w ./, prezentowniki w ../prezentowniki/, a kalendarz i zapowiedzi
// bezpośrednio w src/pages/. Każdy plik .md w src/pages jest artykułem.
const posts = Object.entries({
  ...import.meta.glob('./*.md', { eager: true }),
  ...import.meta.glob('../prezentowniki/*.md', { eager: true }),
  ...import.meta.glob('../*.md', { eager: true }),
})
  .map(([, m]) => m)
  // obecność kategorii = plik jest artykułem; chroni przed wciągnięciem
  // dowolnego innego .md, który trafi do src/pages
  .filter((m) => m.frontmatter?.kategoria)
  .sort((a, b) => new Date(b.frontmatter.data) - new Date(a.frontmatter.data));
// Prezentowniki serii to strony .astro (patrz /prezentowniki/) — nie mają
// frontmattera, więc dane karty biorą się z eksportowanego `meta`.
const zAstro = Object.values(import.meta.glob('../prezentowniki/*.astro', { eager: true }))
  .map((m) => m.meta)
  .filter(Boolean)
  .map(zajawkaZMeta);
const zajawki = [...zAstro, ...zajawkiArtykulow(posts)].sort(
  (a, b) => new Date(b.data) - new Date(a.data),
);
---
<Base title="Artykuły — poradniki, deale, analizy" description="Poradniki zakupowe, analizy dealów i teksty o kolekcjonowaniu klocków LEGO.">
  <h1 style="margin-top:28px">Artykuły</h1>
  <div class="zajawki">
    {zajawki.map((z) => <ZajawkaArtykulu zajawka={z} poziom={2} />)}
  </div>
</Base>
