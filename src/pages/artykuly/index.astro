---
import { jsonldListingu } from '../../lib/jsonld-listingu.js';
import Base from '../../layouts/Base.astro';
import ZajawkaArtykulu from '../../components/ZajawkaArtykulu.astro';
import FiltrKategorii from '../../components/FiltrKategorii.astro';
import { zajawkiArtykulow, zajawkaZMeta, najnowszePierwsze } from '../../lib/artykuly.js';
// Artykuły leżą w ./ oraz – jak kalendarz i zapowiedzi – bezpośrednio
// w src/pages/. Każdy plik .md z polem `kategoria` jest artykułem.
//
// Prezentowniki mają od 27.08.2026 własny dział /prezentowniki/ i NIE wchodzą
// na tę listę: to nie jest kategoria artykułu, tylko osobny format. Dlatego
// nie zaciągamy tu ani ../prezentowniki/*.md, ani tamtejszych stron .astro.
const posts = Object.entries({
  ...import.meta.glob('./*.md', { eager: true }),
  ...import.meta.glob('../*.md', { eager: true }),
  // Aktualności spod /deale/ (Dzień Chłopaka został pod starym adresem) też są
  // tekstami działu – bierzemy z tamtego katalogu tylko je, nie posty dealowe.
  ...Object.fromEntries(
    Object.entries(import.meta.glob('../deale/*.md', { eager: true })).filter(([, m]) => m.frontmatter?.kategoria === 'Aktualności'),
  ),
})
  .map(([, m]) => m)
  .filter((m) => m.frontmatter?.kategoria && m.frontmatter.kategoria !== 'Prezentownik');

// Od 17.09.2026 artykuł bywa stroną .astro, a nie markdownem – poradniki
// z kartami ofert liczą ceny przy budowaniu, więc nie da się ich zapisać
// frontmatterem. Taka strona eksportuje `meta` w tym samym kształcie co
// prezentowniki serii (src/lib/artykuly.js → zajawkaZMeta); `index.astro`
// jej nie ma, więc odpada na filtrze `meta?.url`.
const strony = Object.values(import.meta.glob('./*.astro', { eager: true }))
  .map((m) => m.meta)
  .filter((meta) => meta?.url && meta.kategoria && meta.kategoria !== 'Prezentownik');

const zajawki = [...zajawkiArtykulow(posts), ...strony.map((meta) => zajawkaZMeta(meta))]
  .sort(najnowszePierwsze);

// „Przewodniki" (Marek 11.10.2026): teksty evergreen stoją na stałe pod listą
// chronologiczną (do 18.10.2026 stały nad nią). Na stronie głównej wypadały po 10 nowszych tekstach i traciły
// jedyny mocny link z serwisu. Kolejność = kolejność na stronie; brakujący adres
// (zmieniony slug) po prostu znika z sekcji, build go nie wywraca.
const PRZEWODNIKI = [
  '/artykuly/slowniczek-lego/',
  '/artykuly/jak-rosly-zestawy-lego/',
  '/artykuly/najwieksze-zestawy-lego-star-wars/',
  '/artykuly/najwieksze-zestawy-lego-technic/',
  '/artykuly/ranking-najlepsze-samochody-lego-icons/',
  '/artykuly/najdrozsze-zestawy-lego-rynek-wtorny/',
  '/artykuly/historia-licencji-lego-poczatki/',
  '/artykuly/historia-licencji-lego-star-wars-minecraft/',
];
const poAdresie = new Map(zajawki.map((z) => [z.url.endsWith('/') ? z.url : `${z.url}/`, z]));
const przewodniki = PRZEWODNIKI.map((u) => poAdresie.get(u)).filter(Boolean);
const jsonld = jsonldListingu({ site: Astro.site, nazwa: 'Artykuły', sciezka: '/artykuly/', opis: 'Poradniki zakupowe, analizy dealów i teksty o kolekcjonowaniu klocków LEGO.', pozycje: zajawki.map((z) => ({ nazwa: z.tytul, url: z.url })) });
---
<Base title="Artykuły – poradniki, deale, analizy" description="Poradniki zakupowe, analizy dealów i teksty o kolekcjonowaniu klocków LEGO." jsonld={jsonld}>
  <h1 style="margin-top:28px">Artykuły</h1>
  <h2 class="artykuly-wszystkie">Wszystkie teksty</h2>
  <FiltrKategorii zajawki={zajawki} />
  <div class="zajawki">
    {zajawki.map((z) => <ZajawkaArtykulu zajawka={z} poziom={2} />)}
  </div>
  {przewodniki.length > 0 && (
    <section class="przewodniki" aria-labelledby="przewodniki-naglowek">
      <h2 id="przewodniki-naglowek">Przewodniki</h2>
      <p class="przewodniki-wstep">Teksty, które nie tracą ważności: rankingi, historia licencji, słowniczek.</p>
      <ul class="przewodniki-lista">
        {przewodniki.map((z) => (
          <li>
            <a href={z.url}>
              {z.foto && <img src={z.foto} alt="" loading="lazy" width="72" height="72" />}
              <span><strong>{z.tytul}</strong><small>{z.kategoria}</small></span>
            </a>
          </li>
        ))}
      </ul>
    </section>
  )}
</Base>
