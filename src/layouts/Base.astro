---
import '@fontsource/archivo/700.css';
import '@fontsource/archivo/800.css';
import '../styles/global.css';
import SzukajGlobalne from '../components/SzukajGlobalne.astro';
const { title, description, jsonld, ogImage = '/og.png', noindex = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImageAbs = new URL(ogImage, Astro.site).href;

// Menu główne w jednym miejscu – stąd bierze się też zaznaczenie bieżącej
// sekcji. Bez tego użytkownik na podstronie nie wie, gdzie w serwisie jest.
// Sześć pozycji – menu ma prowadzić do działów, nie do pojedynczych tekstów.
// Kalendarz i Zapowiedzi zeszły z menu 27.08.2026: to artykuły, więc mieszkają
// teraz w /artykuly/ (kategorie „Kalendarze" i „Premiery") i wchodzi się do nich
// stamtąd. Kolekcjoner zszedł, bo dział był pusty – strona zostaje pod adresem,
// żeby nie psuć linków, ale nie zajmuje miejsca w nawigacji.
const MENU = [
  { href: '/', etykieta: '🔥 Promocje dziś', klasa: 'nav--hot' },
  { href: '/deale/', etykieta: 'Deale' },
  { href: '/nowosci/', etykieta: 'Nowości' },
  { href: '/wycofania/', etykieta: 'Wycofania' },
  { href: '/serie/', etykieta: 'Serie' },
  { href: '/prezentowniki/', etykieta: 'Prezentowniki' },
  { href: '/artykuly/', etykieta: 'Artykuły' },
];
// „/" tylko dla samej strony głównej; pozostałe pozycje świecą także na swoich
// podstronach (/serie/technic/ podświetla „Serie", /artykuly/<tekst>/ – „Artykuły").
// aria-current="page" dla dokładnego trafienia, "true" dla sekcji nadrzędnej.
const sciezka = Astro.url.pathname.endsWith('/') ? Astro.url.pathname : `${Astro.url.pathname}/`;
const stanPozycji = (href) => {
  if (sciezka === href) return 'page';
  if (href !== '/' && sciezka.startsWith(href)) return 'true';
  return undefined;
};
---
<!doctype html>
<html lang="pl">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="verify-admitad" content="2fc69e6e81" />
    <title>{title} · tylkoklocki.pl</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="pl_PL" />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImageAbs} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={ogImageAbs} />
    {jsonld && <script type="application/ld+json" set:html={JSON.stringify(jsonld)} />}
    <!-- Cloudflare Web Analytics – darmowe, bez cookies. Token: panel Cloudflare ->
         Analytics & Logs -> Web Analytics -> Add a site (tylkoklocki.pl) -> skopiuj token
         i podmień TOKEN_Z_PANELU poniżej. Do tego czasu skrypt jest nieszkodliwy (no-op). -->
<script defer src="https://static.cloudflareinsights.com/beacon.min.js" data-cf-beacon={'{"token": "0fd406fdce6f46d0ba37b17ae134b0a5"}'}></script>
    <!-- Google tag (gtag.js) – GA4, usługa tylkoklocki.pl -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-5M8LH9SKQC"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-5M8LH9SKQC');
    </script>
  </head>
  <body>
    <a class="skip-link" href="#tresc">Przejdź do treści</a>
    <header class="site-header">
      <div class="wrap">
        <a class="logo" href="/">
          <span class="studs" aria-hidden="true"><i></i><i></i><i></i><i></i></span>
          tylko<em>klocki</em><span style="color:var(--granat-60)">.pl</span>
        </a>
        <SzukajGlobalne />
        <button class="nav-przycisk" type="button" aria-label="Menu" aria-expanded="false" aria-controls="menu-glowne">
          <span class="nav-ikona" aria-hidden="true"><i></i><i></i><i></i></span>
          <span class="nav-przycisk-tekst">Menu</span>
        </button>
        <nav class="nav" id="menu-glowne" aria-label="Menu główne">
          {MENU.map((poz) => (
            <a class={poz.klasa} href={poz.href} aria-current={stanPozycji(poz.href)}>{poz.etykieta}</a>
          ))}
        </nav>
      </div>
    </header>
    <script is:inline>
      // Menu mobilne: przycisk rozwija nawigację. Panel jest zwykłym <nav> –
      // na desktopie CSS pokazuje go zawsze, więc brak JS-a nic nie psuje
      // (przycisk jest wtedy ukryty). Na wąskich ekranach sterujemy klasą
      // .nav--otwarte i aria-expanded, żeby czytniki znały stan.
      (function () {
        var przycisk = document.querySelector('.nav-przycisk');
        var menu = document.getElementById('menu-glowne');
        if (!przycisk || !menu) return;

        var ustaw = function (otwarte) {
          menu.classList.toggle('nav--otwarte', otwarte);
          przycisk.setAttribute('aria-expanded', otwarte ? 'true' : 'false');
        };

        przycisk.addEventListener('click', function () {
          ustaw(przycisk.getAttribute('aria-expanded') !== 'true');
        });

        // wybór linku zamyka menu (nawigacja w obrębie tej samej strony, np. kotwice)
        menu.addEventListener('click', function (e) {
          if (e.target.closest('a')) ustaw(false);
        });

        // Escape zamyka i wraca fokusem na przycisk
        document.addEventListener('keydown', function (e) {
          if (e.key === 'Escape' && przycisk.getAttribute('aria-expanded') === 'true') {
            ustaw(false);
            przycisk.focus();
          }
        });

        // kliknięcie poza nagłówkiem zamyka menu
        document.addEventListener('click', function (e) {
          if (przycisk.getAttribute('aria-expanded') !== 'true') return;
          if (!e.target.closest('.site-header')) ustaw(false);
        });

        // po powiększeniu okna do widoku desktopowego stan menu przestaje mieć
        // znaczenie wizualnie, ale aria-expanded musi wrócić do wartości spójnej
        var szeroki = window.matchMedia('(min-width: 861px)');
        var reset = function () { if (szeroki.matches) ustaw(false); };
        szeroki.addEventListener ? szeroki.addEventListener('change', reset) : szeroki.addListener(reset);
      })();
    </script>

    <script is:inline>
      // Rzeczywista wysokość przyklejonego menu trafia do --h-naglowek, żeby paski
      // filtrów mogły się przykleić dokładnie pod nim (nawigacja zawija się na wąskich
      // ekranach, więc stała wartość by nie wystarczyła).
      (function () {
        var naglowek = document.querySelector('.site-header');
        if (!naglowek) return;
        var ustaw = function () {
          document.documentElement.style.setProperty('--h-naglowek', naglowek.offsetHeight + 'px');
        };
        ustaw();
        addEventListener('resize', ustaw, { passive: true });
        if (window.ResizeObserver) new ResizeObserver(ustaw).observe(naglowek);
      })();
    </script>

    <main class="wrap" id="tresc">
      <slot />
    </main>

    <button class="na-gore" type="button" aria-label="Wróć na górę strony" hidden>↑</button>
    <script is:inline>
      // przycisk „wróć na górę" pojawia się dopiero na długich stronach po przewinięciu
      (function () {
        var przycisk = document.querySelector('.na-gore');
        if (!przycisk) return;
        var przelacz = function () { przycisk.hidden = window.scrollY < 1600; };
        addEventListener('scroll', przelacz, { passive: true });
        przelacz();
        przycisk.addEventListener('click', function () { window.scrollTo({ top: 0, behavior: 'smooth' }); });
      })();
    </script>

    <footer class="site-footer">
      <div class="wrap">
        <div>
          <h4>tylkoklocki.pl</h4>
          <p>Tylko klocki – polujemy na prawdziwe promocje na zestawy LEGO®. Rabaty liczymy zawsze od oficjalnej ceny katalogowej – bez pseudopromocji.</p>
        </div>
        <div>
          <h4>Przejrzystość</h4>
          <p>Część linków na stronie to linki afiliacyjne. Kupując przez nie, wspierasz nasz serwis – Ty nie płacisz ani grosza więcej. Najtańszą ofertę pokazujemy zawsze, niezależnie od prowizji.</p>
        </div>
        <div>
          <h4>Info</h4>
          <p>LEGO® jest znakiem towarowym Grupy LEGO, która nie sponsoruje ani nie wspiera tej strony.<br /><a href="/o-nas/">O nas</a> · <a href="/artykuly/">Wszystkie artykuły</a> · <a href="/wycofania/">Wycofania 2026</a></p>
        </div>
      </div>
    </footer>
  </body>
</html>
