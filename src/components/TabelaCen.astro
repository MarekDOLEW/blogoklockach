---
import sklepy from '../data/sklepy.json';
import redirects from '../data/redirects.json';
const { nr, oferty, cenaKatalogowa } = Astro.props;
const posortowane = [...oferty].sort((a, b) => a.cena - b.cena);
const fmt = (c) => c.toLocaleString('pl-PL', { minimumFractionDigits: 2 }) + ' zł';
const rabat = (c) => Math.round((1 - c / cenaKatalogowa) * 100);
const dataSprawdzenia = posortowane[0]?.data;
const maLink = (sklep) => Boolean(redirects?.[sklep]?.[nr]);
// sklepy z linkiem afiliacyjnym, ale bez oferty cenowej — pokaż wiersz "sprawdź cenę"
const bezCeny = Object.keys(redirects)
  .filter((s) => s !== '_meta' && maLink(s) && !posortowane.some((o) => o.sklep === s));
---
<div class="karta" style="padding: 18px; margin: 18px 0;">
  <table class="tabela-cen">
    <caption>Porównanie cen — LEGO {nr}</caption>
    <thead>
      <tr><th>Sklep</th><th>Cena</th><th>Rabat*</th><th></th></tr>
    </thead>
    <tbody>
      {posortowane.map((o, i) => (
        <tr class={i === 0 ? 'najtanszy' : ''}>
          <td>
            <strong>{sklepy[o.sklep]?.nazwa ?? o.sklep}</strong>
            {o.najnizsza && <span class="badge-najnizsza" style="margin-left:8px">najniższa w historii</span>}
            {o.sklep === 'mediaexpert' && <span style="display:block;font-size:0.72rem;opacity:0.65;">w sklepie bywają kody rabatowe — może być jeszcze taniej</span>}
          </td>
          <td class="cena">{fmt(o.cena)}</td>
          <td>{rabat(o.cena) > 0 ? `−${rabat(o.cena)}%` : '—'}</td>
          <td>
            {maLink(o.sklep) ? (
              <a class="cta" href={`/idz/${o.sklep}/${nr}`} rel="sponsored nofollow">Sprawdź w sklepie →</a>
            ) : (
              <span style="font-size:0.85rem;opacity:0.55;white-space:nowrap;" title="Link afiliacyjny w przygotowaniu">link wkrótce</span>
            )}
          </td>
        </tr>
      ))}
      {bezCeny.map((s) => (
        <tr>
          <td>
            <strong>{sklepy[s]?.nazwa ?? s}</strong>
            {s === 'mediaexpert' && <span style="display:block;font-size:0.72rem;opacity:0.65;">w sklepie bywają kody rabatowe — może być jeszcze taniej</span>}
          </td>
          <td class="cena">—</td>
          <td>—</td>
          <td><a class="cta" href={`/idz/${s}/${nr}`} rel="sponsored nofollow">Sprawdź cenę →</a></td>
        </tr>
      ))}
    </tbody>
  </table>
  <p class="tabela-data">* Rabat liczony od ceny katalogowej LEGO ({fmt(cenaKatalogowa)}). Ceny sprawdzone: {dataSprawdzenia}. Ceny mogą się zmienić.</p>
</div>
