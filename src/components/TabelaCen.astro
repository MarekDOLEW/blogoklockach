---
import { relLinku as relSklepu } from '../lib/oferty.js';
import sklepy from '../data/sklepy.json';
import redirects from '../data/redirects.json';
// Tabela cen jednego zestawu. Zasada z 13.09.2026: w tabeli są WYŁĄCZNIE sklepy,
// które dziś mają ten zestaw w cenniku (oferta z ceną). Nie dokładamy już
// wierszy „Sprawdź cenę" dla sklepów bez oferty – link z przeterminowanego
// feedu (np. Planeta Klocków przy 21323) prowadził do pustej strony i podważał
// wiarygodność całej tabeli.
//
// Wyjątkiem jest LEGO.com – oficjalny sklep pokazujemy zawsze, gdy znamy cenę
// katalogową:
//   dodajLego  – LEGO wciąż sprzedaje: zwykły wiersz z ceną katalogową i linkiem,
//   eolLego    – LEGO zakończyło produkcję: wiersz na końcu, cena katalogowa
//                ze znacznikiem EOL (informacja, ile zestaw kosztował u producenta)
//                i bez przycisku – nie wysyłamy czytelnika tam, gdzie nie kupi.
// cenaKatalogowa jest opcjonalna – lekkie huby (spoza sety.json) jej nie znają,
// wtedy tabela nie pokazuje kolumny rabatu.
const { nr, oferty, cenaKatalogowa = null, dodajLego = false, eolLego = false } = Astro.props;
const fmt = (c) => c.toLocaleString('pl-PL', { minimumFractionDigits: 2 }) + ' zł';
const rabat = (c) => Math.round((1 - c / cenaKatalogowa) * 100);
// link do LEGO.com generuje worker z samego numeru – nie wymaga wpisu w redirects;
// x-kom/smyk/empik tak samo, ale tylko dla setów w sprzedaży – dla wycofanych
// wyszukiwarki tych sklepów bywają puste
const maAfiliacje = (sklep) =>
  sklep === 'lego' ||
  ((sklep === 'xkom' || sklep === 'smyk' || sklep === 'empik') && dodajLego) ||
  Boolean(redirects?.[sklep]?.[nr]);
// zasada: skoro pokazujemy cenę, dajemy przynajmniej zwykły link – worker
// zna szablony wyszukiwarek sklepów (sklepy.json -> szukaj)
const maLink = (sklep) => maAfiliacje(sklep) || Boolean(sklepy[sklep]?.szukaj);
// „sponsored" tylko tam, gdzie faktycznie mamy prowizję – lista sklepów bez
// niej mieszka w lib/oferty.js, żeby wszystkie listingi mówiły to samo.
const relLinku = (sklep) => (maAfiliacje(sklep) ? relSklepu(sklep, nr) : 'nofollow');

// Po EOL wiersz LEGO z sety.json (cena katalogowa) nie jest już ofertą –
// przenosimy go do wiersza informacyjnego na końcu.
const sklepowe = eolLego ? oferty.filter((o) => o.sklep !== 'lego') : oferty;
const zLego = dodajLego && !sklepowe.some((o) => o.sklep === 'lego') && cenaKatalogowa
  ? [{ sklep: 'lego', cena: cenaKatalogowa, data: null }]
  : [];
// Ceneo to porównywarka, nie sklep: jego cena to najniższa oferta rynkowa,
// a klient po kliknięciu trafia na kartę produktu w Ceneo i dopiero stamtąd
// do sklepu. Dlatego stoi zawsze na końcu tabeli i nie bierze udziału
// w sortowaniu ani w wyróżnieniu "najtańszy".
const ceneo = [...sklepowe, ...zLego].find((o) => o.sklep === 'ceneo') ?? null;
const posortowane = [...sklepowe, ...zLego]
  .filter((o) => o.sklep !== 'ceneo')
  .sort((a, b) => a.cena - b.cena);
const dataSprawdzenia = posortowane.find((o) => o.data)?.data;
const wierszLegoEol = eolLego && cenaKatalogowa ? { sklep: 'lego', cena: cenaKatalogowa } : null;

// sklepy, w których cena na stronie potrafi odbiegać od tej z feedu
// (kody rabatowe i akcje na koszyk, których feedy produktowe nie pokazują)
const UWAGA_SKLEP = {
  mediaexpert: 'w sklepie bywają kody rabatowe – może być jeszcze taniej',
  planetaklockow: 'sklep prowadzi akcje rabatowe niewidoczne w cenniku – na stronie może być taniej',
  lego: 'oficjalna strona LEGO',
};
---
<div class="karta tabela-cen-wrap">
  <table class="tabela-cen">
    <caption>Porównanie cen – LEGO {nr}</caption>
    <thead>
      <tr><th>Sklep</th><th>Cena</th>{cenaKatalogowa && <th>Rabat*</th>}<th></th></tr>
    </thead>
    <tbody>
      {posortowane.map((o, i) => (
        <tr class={i === 0 ? 'najtanszy' : ''}>
          <td class="kc-sklep">
            <strong>{sklepy[o.sklep]?.nazwa ?? o.sklep}</strong>
            {o.najnizsza && <span class="badge-najnizsza" style="margin-left:8px">najniższa w historii</span>}
            {UWAGA_SKLEP[o.sklep] && <span class="kc-uwaga">{UWAGA_SKLEP[o.sklep]}</span>}
          </td>
          <td class="cena kc-cena">{fmt(o.cena)}</td>
          {cenaKatalogowa && <td class="kc-rabat">{rabat(o.cena) > 0 ? `−${rabat(o.cena)}%` : '–'}</td>}
          <td class="kc-cta">
            {maLink(o.sklep) ? (
              <a class="cta" href={`/idz/${o.sklep}/${nr}`} rel={relLinku(o.sklep)}>Sprawdź w sklepie →</a>
            ) : (
              <span class="link-wkrotce" title="Link afiliacyjny w przygotowaniu">link wkrótce</span>
            )}
          </td>
        </tr>
      ))}
      {wierszLegoEol && (
        <tr class="wiersz-eol">
          <td class="kc-sklep">
            <strong>{sklepy.lego?.nazwa ?? 'LEGO.com'}</strong>
            <span class="kc-uwaga">oficjalny sklep – produkcja zakończona, zestaw został u innych sprzedawców</span>
          </td>
          <td class="cena kc-cena">{fmt(wierszLegoEol.cena)}<span class="tag-eol" title="EOL – LEGO zakończyło produkcję i już nie sprzedaje">EOL</span></td>
          {cenaKatalogowa && <td class="kc-rabat">–</td>}
          <td class="kc-cta"><span class="kc-eol-info">produkcja zakończona</span></td>
        </tr>
      )}
      {ceneo && (
        <tr class="wiersz-ceneo">
          <td class="kc-sklep">
            <strong>{sklepy.ceneo?.nazwa ?? 'Ceneo'}</strong>
            <span class="kc-uwaga">porównywarka – najniższa oferta w całym rynku, sklep wybierasz na Ceneo</span>
          </td>
          <td class="cena kc-cena">{fmt(ceneo.cena)}</td>
          {cenaKatalogowa && <td class="kc-rabat">{rabat(ceneo.cena) > 0 ? `−${rabat(ceneo.cena)}%` : '–'}</td>}
          <td class="kc-cta"><a class="cta" href={`/idz/ceneo/${nr}`} rel="sponsored nofollow">Porównaj oferty →</a></td>
        </tr>
      )}
    </tbody>
  </table>
  <p class="tabela-data">{cenaKatalogowa && <>* Rabat liczony od ceny katalogowej LEGO ({fmt(cenaKatalogowa)}). </>}{dataSprawdzenia && <>Ceny sprawdzone: {dataSprawdzenia}. </>}{wierszLegoEol && <>EOL – LEGO zakończyło produkcję tego zestawu; sklepy sprzedają zapasy, dopóki je mają. </>}Sklepy prowadzą też własne promocje i kody rabatowe, których nie widać w cennikach, i zmieniają ceny także w ciągu dnia – kwota powyżej jest ostatnią, jaką zobaczyliśmy, a wiążąca jest zawsze cena w koszyku sklepu. Różnica zwykle wypada na Twoją korzyść.</p>
</div>
