---
import sklepy from '../data/sklepy.json';
import redirects from '../data/redirects.json';
// cenaKatalogowa jest opcjonalna — lekkie huby (spoza sety.json) jej nie znają,
// wtedy tabela nie pokazuje kolumny rabatu.
// dodajLego dokłada wiersz LEGO.com (oficjalny sklep, link bezpośredni z workera),
// jeśli ofert LEGO nie ma już na liście.
const { nr, oferty, cenaKatalogowa = null, dodajLego = false } = Astro.props;
const fmt = (c) => c.toLocaleString('pl-PL', { minimumFractionDigits: 2 }) + ' zł';
const rabat = (c) => Math.round((1 - c / cenaKatalogowa) * 100);
// link do LEGO.com generuje worker z samego numeru — nie wymaga wpisu w redirects
const maLink = (sklep) => sklep === 'lego' || Boolean(redirects?.[sklep]?.[nr]);

const zLego = dodajLego && !oferty.some((o) => o.sklep === 'lego') && cenaKatalogowa
  ? [{ sklep: 'lego', cena: cenaKatalogowa, data: null }]
  : [];
const posortowane = [...oferty, ...zLego].sort((a, b) => a.cena - b.cena);
const dataSprawdzenia = posortowane.find((o) => o.data)?.data;
// sklepy z linkiem afiliacyjnym, ale bez oferty cenowej — pokaż wiersz "sprawdź cenę"
const bezCeny = Object.keys(redirects)
  .filter((s) => s !== '_meta' && maLink(s) && !posortowane.some((o) => o.sklep === s));
if (dodajLego && !posortowane.some((o) => o.sklep === 'lego') && !bezCeny.includes('lego')) {
  bezCeny.push('lego');
}

// sklepy, w których cena na stronie potrafi odbiegać od tej z feedu
// (kody rabatowe i akcje na koszyk, których feedy produktowe nie pokazują)
const UWAGA_SKLEP = {
  mediaexpert: 'w sklepie bywają kody rabatowe — może być jeszcze taniej',
  planetaklockow: 'sklep prowadzi akcje rabatowe niewidoczne w cenniku — na stronie może być taniej',
  lego: 'oficjalny sklep LEGO — link bezpośredni, nie afiliacyjny',
};
---
<div class="karta" style="padding: 18px; margin: 18px 0;">
  <table class="tabela-cen">
    <caption>Porównanie cen — LEGO {nr}</caption>
    <thead>
      <tr><th>Sklep</th><th>Cena</th>{cenaKatalogowa && <th>Rabat*</th>}<th></th></tr>
    </thead>
    <tbody>
      {posortowane.map((o, i) => (
        <tr class={i === 0 ? 'najtanszy' : ''}>
          <td>
            <strong>{sklepy[o.sklep]?.nazwa ?? o.sklep}</strong>
            {o.najnizsza && <span class="badge-najnizsza" style="margin-left:8px">najniższa w historii</span>}
            {UWAGA_SKLEP[o.sklep] && <span style="display:block;font-size:0.72rem;opacity:0.65;">{UWAGA_SKLEP[o.sklep]}</span>}
          </td>
          <td class="cena">{fmt(o.cena)}</td>
          {cenaKatalogowa && <td>{rabat(o.cena) > 0 ? `−${rabat(o.cena)}%` : '—'}</td>}
          <td>
            {maLink(o.sklep) ? (
              <a class="cta" href={`/idz/${o.sklep}/${nr}`} rel={o.sklep === 'lego' ? 'nofollow' : 'sponsored nofollow'}>Sprawdź w sklepie →</a>
            ) : (
              <span style="font-size:0.85rem;opacity:0.55;white-space:nowrap;" title="Link afiliacyjny w przygotowaniu">link wkrótce</span>
            )}
          </td>
        </tr>
      ))}
      {bezCeny.map((s) => (
        <tr>
          <td>
            <strong>{sklepy[s]?.nazwa ?? s}</strong>
            {UWAGA_SKLEP[s] && <span style="display:block;font-size:0.72rem;opacity:0.65;">{UWAGA_SKLEP[s]}</span>}
          </td>
          <td class="cena">—</td>
          {cenaKatalogowa && <td>—</td>}
          <td><a class="cta" href={`/idz/${s}/${nr}`} rel={s === 'lego' ? 'nofollow' : 'sponsored nofollow'}>Sprawdź cenę →</a></td>
        </tr>
      ))}
    </tbody>
  </table>
  <p class="tabela-data">{cenaKatalogowa && <>* Rabat liczony od ceny katalogowej LEGO ({fmt(cenaKatalogowa)}). </>}{dataSprawdzenia && <>Ceny sprawdzone: {dataSprawdzenia}. </>}Sklepy prowadzą też własne promocje i kody rabatowe, których nie widać w cennikach — cena w sklepie może się różnić od podanej, zwykle na Twoją korzyść.</p>
</div>
