---
import sklepy from '../data/sklepy.json';
import redirects from '../data/redirects.json';
import galerie from '../data/galerie.json';
import sety from '../data/sety.json';
import ofertyFeed from '../data/oferty_feed.json';
import { polaczOferty, linkAfiliacyjny, nazwaSklepu, fmtCena, relLinku as relSklepu } from '../lib/oferty.js';

// Karta jednego zestawu w prezentowniku serii.
//
// Warstwa cenowa jest zgodna ze standardem redakcyjnym (§18–19): trwała
// drabina RRP -> dobra cena -> bardzo dobra cena -> próg zakupu, bez daty
// sprawdzenia i bez chwilowego snapshotu ofert. Bieżące kwoty czytelnik
// znajdzie w tabeli na /zestaw/<nr>/, która odświeża się codziennie z feedów.
//
// Sklepy publikacyjne (2–3) dobiera redakcja w danych strony, nie kod —
// afiliacja nie może decydować o tym doborze. Kod tylko sprawdza, czy dla
// danego sklepu istnieje przekierowanie; jeśli nie, wiersz pomija.
// wiek podajemy tylko wtedy, gdy mamy go w sety.json — to dana z pudełka
// i nie zgadujemy jej. Niezależnie od niej każda karta ma redakcyjne
// "dla kogo", bo w prezentowniku to ono jest właściwą odpowiedzią.
const {
  nr, nazwa, rocznik, elementy, rrp, dlaKogo,
  wiek = null, dobra = null, bardzoDobra = null, prog = null,
  status = null, sklepyPublikacyjne = [],
} = Astro.props;

const zl = (c) => c.toLocaleString('pl-PL', { minimumFractionDigits: 2 }) + ' zł';
const maLink = (s) => s === 'lego' || Boolean(redirects?.[s]?.[nr]) || Boolean(sklepy[s]?.szukaj);
const rel = (s) => relSklepu(s, nr);
const doPokazania = sklepyPublikacyjne.filter(maLink);
// dodatkowe zdjęcia z galerie.json, jeśli redakcja je dla tego setu zebrała
const dodatkowe = (galerie[nr] ?? []).map((_, i) => `/img/${nr}-${i + 1}.jpg`);

// „Kup teraz": sklepy, które DZIŚ schodzą do progu dobrej ceny z drabiny powyżej.
// Nie jest to ręczny snapshot — blok liczy się przy każdym budowaniu strony,
// a build leci z każdą aktualizacją cen, więc odświeża się razem z tabelą huba.
// O doborze decyduje wyłącznie cena: sortujemy od najtańszego i bierzemy do trzech
// sklepów, niezależnie od tego, czy i ile płacą za polecenie. Ceneo pomijamy —
// to porównywarka, a nie sklep, do którego można wysłać czytelnika po zestaw.
const wProgu = dobra
  ? polaczOferty(sety[nr]?.oferty ?? [], ofertyFeed?.sety?.[nr] ?? null, nr)
      .filter((o) => o.sklep !== 'ceneo' && o.cena <= dobra && linkAfiliacyjny(o.sklep, nr))
      .sort((a, b) => a.cena - b.cena)
      .slice(0, 3)
  : [];
const bardzoTanio = (cena) => Boolean(bardzoDobra && cena <= bardzoDobra);
---
<div class="prezent" id={`zestaw-${nr}`}>
  {/* Góra karty: zdjęcie po lewej, obok nazwa zestawu, dane z pudełka
      i „dla kogo". Opis, drabina cenowa i sklepy idą niżej, na pełną
      szerokość — tekst czyta się lepiej w jednej kolumnie niż w wąskiej
      szpalcie obok zdjęcia. */}
  <div class="prezent__gora">
    <figure class="prezent__media">
      <img
        class="prezent__foto"
        src={`/img/${nr}.jpg`}
        alt={`LEGO ${nr} ${nazwa}`}
        loading="lazy"
        decoding="async"
        width="640"
        height="640"
      />
      {dodatkowe.length > 0 && (
        <span class="prezent__miniatury">
          {dodatkowe.map((u, i) => (
            <img src={u} alt={`LEGO ${nr} ${nazwa} — zdjęcie ${i + 2}`} loading="lazy" decoding="async" width="120" height="120" />
          ))}
        </span>
      )}
    </figure>

    <div class="prezent__szczyt">
      <p class="prezent__nagl">
        <a href={`/zestaw/${nr}/`}>LEGO {nr} {nazwa}</a>
        {status === 'eol' && <span class="status status--stop">wycofany</span>}
        {status === 'znika' && <span class="status status--maybe">wycofanie w XII 2026</span>}
      </p>

      <dl class="prezent__dane">
        <div><dt>Elementy</dt><dd>{elementy}</dd></div>
        {wiek && <div><dt>Wiek z pudełka</dt><dd>{wiek}</dd></div>}
        <div><dt>Rocznik</dt><dd>{rocznik}</dd></div>
        <div><dt>Cena katalogowa</dt><dd>{zl(rrp)}</dd></div>
      </dl>

      <p class="prezent__dlakogo"><span>Dla kogo</span> {dlaKogo}</p>
    </div>
  </div>

  <div class="prezent__tresc">
    <slot />

    {/* drabina cenowa świadomie NIE jest tabelą: globalne style .prose th
        malują nagłówki na granatowo, co przy etykietach w wierszach wygląda
        jak nagłówek tabeli, a nie jak lista progów */}
    {(dobra || bardzoDobra) && (
      <div class="prezent__drabina">
        <p class="prezent__drabina-tytul">Kiedy warto kupić</p>
        <dl>
          <div><dt>Cena katalogowa</dt><dd>{zl(rrp)}</dd></div>
          {dobra && <div><dt>Dobra cena</dt><dd>ok. {zl(dobra)}</dd></div>}
          {bardzoDobra && <div><dt>Bardzo dobra cena</dt><dd>poniżej {zl(bardzoDobra)}</dd></div>}
        </dl>
        {prog && <p class="prezent__prog"><span>Próg zakupu</span> {prog}</p>}
      </div>
    )}

    {dobra && (
      wProgu.length > 0 ? (
        <div class="prezent__kup">
          <p class="prezent__kup-tytul">Kup teraz w</p>
          <ul class="prezent__kup-lista">
            {wProgu.map((o) => (
              <li>
                <a href={linkAfiliacyjny(o.sklep, nr)} rel={rel(o.sklep)}>{nazwaSklepu(o.sklep)}</a>
                <b>{fmtCena(o.cena)}</b>
                <span class={bardzoTanio(o.cena) ? 'prezent__kup-poziom prezent__kup-poziom--top' : 'prezent__kup-poziom'}>
                  {bardzoTanio(o.cena) ? 'bardzo dobra cena' : 'dobra cena'}
                </span>
              </li>
            ))}
          </ul>
        </div>
      ) : (
        <p class="prezent__kup-brak">
          Dziś żaden ze śledzonych sklepów nie schodzi do dobrej ceny — poczekaj albo sprawdź
          {' '}<a href={`/zestaw/${nr}/`}>aktualne oferty</a>.
        </p>
      )
    )}

    <p class="prezent__cta">
      {doPokazania.map((s, i) => (
        <>
          {i > 0 && <span aria-hidden="true"> · </span>}
          <a href={`/idz/${s}/${nr}`} rel={rel(s)}>{sklepy[s]?.nazwa ?? s}</a>
        </>
      ))}
      {doPokazania.length > 0 && <span aria-hidden="true"> · </span>}
      <a href={`/zestaw/${nr}/`}><b>wszystkie ceny i historia</b></a>
    </p>
  </div>
</div>
