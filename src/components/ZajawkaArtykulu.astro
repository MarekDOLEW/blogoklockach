---
// Karta artykułu: data i kategoria, pod nimi zdjęcie z tematu tekstu,
// dalej tytuł i opis. Ten sam komponent na stronie głównej, w /artykuly/
// i w /prezentownikach/ — trzy listingi wyglądają identycznie.
const { zajawka, poziom = 3 } = Astro.props;
const Tytul = `h${poziom}`;
// data-kategoria zasila filtr kategorii w /artykuly/ (FiltrKategorii.astro).
// Kategoria z karty (`karta_znacznik`) potrafi być inna niż nazwa kategorii —
// np. „7 lat" zamiast „Prezentownik" — dlatego do filtrowania służy osobne
// pole `grupa`, a nie tekst widoczny w plakietce.
const grupa = zajawka.grupa ?? zajawka.kategoria;
---
<a class="karta zajawka" href={zajawka.url} data-kategoria={grupa}>
  <span class="nr">{zajawka.data} · {zajawka.kategoria}</span>
  {(zajawka.tagi ?? []).length > 0 && (
    <span class="zajawka-tagi">
      {zajawka.tagi.map((t) => <span class="badge-tag">{t}</span>)}
    </span>
  )}
  {zajawka.foto ? (
    <img
      class="zajawka-foto"
      src={zajawka.foto}
      alt={zajawka.fotoAlt}
      loading="lazy"
      width="480"
      height="360"
    />
  ) : (
    <span class="zajawka-foto zajawka-foto--brak" aria-hidden="true">
      <span class="studs studs--granat"><i></i><i></i><i></i><i></i></span>
    </span>
  )}
  <Tytul>{zajawka.tytul}</Tytul>
  <p>{zajawka.opis}</p>
  <span class="zajawka-wiecej">Czytaj →</span>
</a>
